{
  "name": "e-icerik-editor",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "zustand": "^5.0.12"
  },
  "scripts": {
    "start": "node dev.mjs",
    "client": "react-scripts start",
    "server": "node server.mjs",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "test:unit": "react-scripts test --watchAll=false --runInBand",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "pdf:storyboard": "node scripts/pdf-storyboard/parse-storyboard-pdf.mjs",
    "pdf:storyboard:help": "node scripts/pdf-storyboard/parse-storyboard-pdf.mjs --help"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.8.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^27.5.1",
    "prettier": "^3.0.0"
  }
}
