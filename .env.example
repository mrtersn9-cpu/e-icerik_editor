# Node.js sunucusu (server.mjs) ortam degiskenleri ornek dosyasi.
#
# Kullanmak icin: bu dosyayi ".env" olarak kopyalayin ve gercek degerleri girin.
#   cp .env.example .env
#
# server.mjs baslarken ".env" dosyasini (varsa) otomatik okur. Bu dosya git'e
# eklenmez (.gitignore), sadece ornek/sablon olarak burada durur.

PORT=4001

# SQLite veritabani ve guvenlik log klasoru.
EICERIK_DATA_DIR=./data

# Sabit iki editor kullanicisi. Canli ortamda MUTLAKA doldurun, aksi halde
# server.mjs varsayilan "1234" sifresiyle calisir (NODE_ENV=production'da
# bu degiskenler bos ise sunucu baslamayi reddeder).
EICERIK_USER1_NAME=Kullanici 1
EICERIK_USER1_PASSWORD=
EICERIK_USER2_NAME=Kullanici 2
EICERIK_USER2_PASSWORD=

# Imzali oturum tokenlari icin uzun/rastgele bir secret.
EICERIK_SESSION_TOKEN_SECRET=

# /api/admin/* yonetim endpointleri icin admin token.
EICERIK_ADMIN_TOKEN=

# Virgulle ayrilmis izinli CORS origin listesi. Canli URL ornegi:
EICERIK_ALLOWED_ORIGINS=https://editori.hepsibirdijital.com,http://localhost:3000

# Opsiyonel ayarlar (varsayilanlar server.mjs icinde tanimli).
# EICERIK_SESSION_TTL_MS=60000
# EICERIK_SESSION_TOKEN_TTL_MS=28800000
# EICERIK_LOGIN_RATE_WINDOW_MS=300000
# EICERIK_LOGIN_RATE_MAX_ATTEMPTS=5
# EICERIK_LOGIN_RATE_LOCK_MS=600000
# EICERIK_BODY_LIMIT_BYTES=10000000
