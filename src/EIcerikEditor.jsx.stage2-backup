                value={sel.style?.borderRadius || 0}
                onChange={(e) =>
                  patchObj(sel.id, { style: { ...sel.style, borderRadius: +e.target.value } })
                }
              />
            </div>
            {sel.imageData && (
              <label
                style={{
                  display: 'block',
                  padding: '4px 0',
                  borderRadius: 5,
                  border: '1px solid #4CAF50',
                  background: '#4CAF5022',
                  color: '#4CAF50',
                  fontSize: 10,
                  fontWeight: 600,
                  cursor: 'pointer',
                  textAlign: 'center',
                }}
              >
                Resim Değiştir
                <input
                  type="file"
                  accept="image/*"
                  style={{ display: 'none' }}
                  onChange={(ev) => {
                    const f = ev.target.files[0];
                    if (!f) return;
                    const r = new FileReader();
                    r.onload = (x) => patchObj(sel.id, { imageData: x.target.result });
                    r.readAsDataURL(f);
