function ActivityScreenFlowEditor({
  activity,
  onUpdate,
  simplified = false,
  layerPresets = [],
  onSaveLayerPreset = () => '',
  onApplyLayerPreset = () => {},
}) {
  const layers = getActivityLayers(activity);
  const resolvedLayerNames = buildResolvedLayerNameMap(layers, activity);
  const orderedLayers = [
    ...layers.filter((layer) => layer.kind !== 'base'),
    ...layers.filter((layer) => layer.kind === 'base'),
  ];
  const [presetName, setPresetName] = useState('');
  const [selectedPresetId, setSelectedPresetId] = useState('');
  const patch = (p) => onUpdate({ ...activity, ...p });
  const renameLayer = (layerId, name) => {
    const rawName = String(name ?? '');
    patch({
      layers: layers.map((layer) =>
        layer.id === layerId ? { ...layer, name: rawName, autoName: !rawName.trim() } : layer
      ),
    });
  };
  const addLayer = () => {
    const nextLayer = createLayer('Katman', layers.length);
    patch({ layers: [...layers, nextLayer], activeLayerId: nextLayer.id });
  };
  const moveLayer = (layerId, direction = -1) => {
    const currentIndex = layers.findIndex((layer) => layer.id === layerId);
    if (currentIndex === -1) return;
    const targetIndex = currentIndex + direction;
    if (targetIndex < 0 || targetIndex >= layers.length) return;
    const nextLayers = [...layers];
    [nextLayers[currentIndex], nextLayers[targetIndex]] = [
      nextLayers[targetIndex],
      nextLayers[currentIndex],
    ];
    patch({ layers: nextLayers });
  };
  const removeLayer = (layerId) => {
    const layer = layers.find((item) => item.id === layerId);
    if (!layer || layer.kind === 'base') return;
    patch({
      layers: layers.filter((item) => item.id !== layerId),
      activeLayerId: activity.activeLayerId === layerId ? 'base' : activity.activeLayerId,
      objects: (activity.objects || []).map((object) =>
        (object.layerId || 'base') === layerId ? { ...object, layerId: 'base' } : object
      ),
    });
  };
  const cloneActiveLayer = () => {
    const sourceLayerId = activity.activeLayerId || 'base';
    const sourceLayer = layers.find((layer) => layer.id === sourceLayerId) || layers[0];
    if (!sourceLayer) return;
    const sourceLayerName = resolvedLayerNames[sourceLayer.id] || 'Layer';
    const nextLayer = {
      ...createLayer('Katman', layers.length),
      name: `${sourceLayerName} Copy`,
      autoName: false,
    };
    const clonedObjects = (activity.objects || [])
      .filter((object) => (object.layerId || 'base') === sourceLayerId)
      .map((object) => ({ ...object, id: uid(), layerId: nextLayer.id }));
    patch({
      layers: [...layers, nextLayer],
      activeLayerId: nextLayer.id,
      objects: [...(activity.objects || []), ...clonedObjects],
    });
  };
  useEffect(() => {
    setPresetName(`${activity?.name || 'Yeni Etkinlik'} Layer Set`);
  }, [activity?.id, activity?.name]);

  useEffect(() => {
    if (!layerPresets.length) {
      setSelectedPresetId('');
      return;
    }
    if (!layerPresets.some((item) => item.id === selectedPresetId)) {
      setSelectedPresetId(layerPresets[0].id);
    }
  }, [layerPresets, selectedPresetId]);

  const selectedPreset = layerPresets.find((item) => item.id === selectedPresetId) || null;
  const handleSaveCurrentPreset = () => {
    const finalName =
      String(presetName || '').trim() || `${activity?.name || 'Yeni Etkinlik'} Layer Set`;
    const savedId = onSaveLayerPreset(finalName, activity);
    if (savedId) setSelectedPresetId(savedId);
  };
  const handleApplySelectedPreset = () => {
    if (!selectedPreset) return;
    onApplyLayerPreset(selectedPreset.id, activity?.id);
  };

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
      <div
        style={{
          padding: '12px 14px',
          borderRadius: 16,
          border: '1px solid #bfdbfe',
          background: 'linear-gradient(135deg,#eff6ff,#ffffff)',
          color: '#1d4ed8',
          lineHeight: 1.7,
        }}
      >
        <div style={{ fontSize: 12, fontWeight: 900, marginBottom: 6 }}>Manuel Layer Akışı</div>
        <div style={{ fontSize: 11 }}>
          Bu bölüm artık otomatik tanıtım, menü, doğru veya yanlış ekranı üretmiyor. Sahne akışını
          tamamen layer + trigger mantığıyla kuruyoruz.
        </div>
      </div>

      {!simplified && (
        <div style={{ display: 'flex', gap: 8 }}>
          <button
            onClick={addLayer}
            style={{
              flex: 1,
              minHeight: 34,
              borderRadius: 10,
              border: '1px solid #93c5fd',
              background: '#ffffff',
              color: '#1d4ed8',
              fontSize: 11,
              fontWeight: 900,
              cursor: 'pointer',
            }}
          >
            + Yeni Layer
          </button>
          <button
            onClick={cloneActiveLayer}
            style={{
              flex: 1,
              minHeight: 34,
              borderRadius: 10,
              border: '1px solid #cbd5e1',
              background: '#ffffff',
              color: '#334155',
              fontSize: 11,
              fontWeight: 900,
              cursor: 'pointer',
            }}
          >
            Aktifi Kopyala
          </button>
        </div>
      )}

      {!simplified && (
        <div
          style={{
            padding: 12,
            borderRadius: 14,
            border: '1px solid #cbd5e1',
            background: '#ffffff',
            display: 'flex',
            flexDirection: 'column',
            gap: 10,
          }}
        >
          <div>
            <div style={{ fontSize: 11, fontWeight: 900, color: '#0f172a' }}>
              Kitap İçi Layer Şablonu
            </div>
            <div style={{ fontSize: 10, color: '#64748b', lineHeight: 1.6, marginTop: 4 }}>
              Bu etkinliğin layer düzenini aynı kitaptaki başka etkinliklerde tekrar çağırabilirsin.
            </div>
          </div>
          <div
            style={{
              display: 'grid',
              gridTemplateColumns: 'minmax(0,1.1fr) minmax(0,.9fr)',
              gap: 8,
            }}
          >
            <input
              value={presetName}
              onChange={(e) => setPresetName(e.target.value)}
              placeholder="Layer şablon adı"
              style={{
                minHeight: 34,
                borderRadius: 10,
                border: '1px solid #cbd5e1',
                background: '#ffffff',
                color: '#0f172a',
                padding: '0 10px',
                fontSize: 11,
                outline: 'none',
              }}
            />
            <button
              onClick={handleSaveCurrentPreset}
              style={{
                minHeight: 34,
                borderRadius: 10,
                border: '1px solid #93c5fd',
                background: '#eff6ff',
                color: '#1d4ed8',
                fontSize: 11,
                fontWeight: 900,
                cursor: 'pointer',
              }}
            >
              Bu Yapıyı Kaydet
            </button>
          </div>
          <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0,1fr) auto', gap: 8 }}>
            <select
              value={selectedPresetId}
              onChange={(e) => setSelectedPresetId(e.target.value)}
              style={{
                minHeight: 34,
                borderRadius: 10,
                border: '1px solid #cbd5e1',
                background: '#ffffff',
                color: '#0f172a',
                padding: '0 10px',
                fontSize: 11,
                outline: 'none',
              }}
            >
              {layerPresets.length === 0 && <option value="">Kayıtlı layer şablonu yok</option>}
              {layerPresets.map((item) => (
                <option key={item.id} value={item.id}>
                  {item.name}
                </option>
              ))}
            </select>
            <button
              onClick={handleApplySelectedPreset}
              disabled={!selectedPreset}
              style={{
                minWidth: 132,
                minHeight: 34,
                borderRadius: 10,
                border: '1px solid #cbd5e1',
                background: selectedPreset ? '#ffffff' : '#f8fafc',
                color: selectedPreset ? '#334155' : '#94a3b8',
                fontSize: 11,
                fontWeight: 900,
                cursor: selectedPreset ? 'pointer' : 'default',
              }}
            >
              Bu Etkinliğe Çağır
            </button>
          </div>
          <div style={{ fontSize: 10, color: '#64748b' }}>
            {layerPresets.length
              ? `${layerPresets.length} kayıtlı şablon hazır.`
              : 'Henüz aynı kitap için kayıtlı bir layer şablonu yok.'}
          </div>
        </div>
      )}

      <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
        {orderedLayers.map((layer, index) => {
          const isActive = (activity.activeLayerId || 'base') === layer.id;
          const isBase = layer.kind === 'base';
          const layerObjects = (activity.objects || []).filter(
            (object) => (object.layerId || 'base') === layer.id
          );
          return (
            <div
              key={layer.id}
              style={{
                background: isActive ? 'linear-gradient(180deg,#dbeafe,#ffffff)' : '#ffffff',
                border: `1px solid ${isActive ? '#93c5fd' : '#dbe7f5'}`,
                borderRadius: 12,
                padding: 10,
                boxShadow: isActive
                  ? '0 10px 20px rgba(59,130,246,.10)'
                  : '0 6px 14px rgba(15,23,42,.04)',
              }}
            >
              <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 8 }}>
                <span
                  style={{
                    padding: '3px 7px',
                    borderRadius: 999,
                    background: isBase ? '#e2e8f0' : '#dbeafe',
