function appendPdfImportLog(logs = [], entry = null) {
  if (!Array.isArray(logs) || !entry?.message) return logs;
  const previous = logs[logs.length - 1];
  if (previous?.message === entry.message && previous?.tone === entry.tone) {
    return logs;
  }
  logs.push(entry);
  return logs;
}

