    switch (resolved) {
      case 'toggle-menu':
        setMenuOpen((value) => !value);
        return;
      case 'check':
        evaluateMatches();
        return;
      case 'answer':
        revealSolution();
        return;
      case 'restart':
        resetFlow();
        return;
      case 'complete':
        finishSuccess();
        return;
      case 'package':
        openGuide(phase === 'play' ? 'play' : 'intro');
