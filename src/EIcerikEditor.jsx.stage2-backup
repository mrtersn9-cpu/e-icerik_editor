      if (!canvasRef.current) return;

      if (e.key === 'Delete' || e.key === 'Backspace') {
        e.preventDefault();
        canvasRef.current.deleteSelected();
      } else if (modKey && e.key.toLowerCase() === 'c') {
        e.preventDefault();
