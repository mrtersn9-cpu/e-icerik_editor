                    minWidth: 68,
                    minHeight: 28,
                    borderRadius: 8,
                    border: '1px solid #cbd5e1',
                    background: '#ffffff',
                    color: isActive ? '#1d4ed8' : '#475569',
                    fontSize: 10,
                    fontWeight: 800,
                    cursor: 'pointer',
