                />
              </label>
            )}
            <div style={{ display: 'flex', gap: 10 }}>
              <label
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 5,
                  fontSize: 10,
                  color: '#78909C',
                  cursor: 'pointer',
                }}
              >
                <input
                  type="checkbox"
                  checked={sel.visible !== false}
                  onChange={(e) => patchObj(sel.id, { visible: e.target.checked })}
                  style={{ accentColor: '#4CAF50' }}
                />
                Görünür
              </label>
              <label
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 5,
                  fontSize: 10,
                  color: '#78909C',
                  cursor: 'pointer',
                }}
              >
                <input
                  type="checkbox"
                  checked={!!sel.locked}
                  onChange={(e) => patchObj(sel.id, { locked: e.target.checked })}
                  style={{ accentColor: '#FF9800' }}
                />
                Kilitli
              </label>
            </div>
          </div>
        </div>
