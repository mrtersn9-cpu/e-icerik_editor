function BookPanel({
  books,
  selPubId,
  selId,
  onSelect,
  onChange,
  currentProjectId,
  activities,
  onActivitiesChange,
  onOpenPreviewEditor = () => {},
}) {
  const [showModal, setShowModal] = useState(false);
  const [newName, setNewName] = useState('');
  const [search, setSearch] = useState('');
  const [editId, setEditId] = useState(null);
  const [editName, setEditName] = useState('');
  const [pdfBusy, setPdfBusy] = useState(false);
  const [pdfMessage, setPdfMessage] = useState('');
  const [pdfError, setPdfError] = useState('');
  const [pdfLogs, setPdfLogs] = useState([]);
  const [pdfStatusOpen, setPdfStatusOpen] = useState(false);
  const pdfInputRef = useRef(null);
  const pushPdfStatus = useCallback((message, tone = 'info') => {
    const entry = createPdfStatusEntry(message, tone);
    if (!entry.message) return null;
    setPdfMessage(entry.message);
    setPdfLogs((prev) => {
      if (
        prev[prev.length - 1]?.message === entry.message &&
        prev[prev.length - 1]?.tone === entry.tone
      ) {
        return prev;
      }
      return [...prev.slice(-11), entry];
    });
    return entry;
  }, []);
  const filtered = books.filter((b) => b.publisherId === selPubId);
  const searched = filtered.filter((b) =>
    (b.name || '').toLowerCase().includes(search.trim().toLowerCase())
  );
  const selectedBook = books.find((book) => book.id === selId) || null;
  const selectedBookImports = selectedBook?.pdfImports || [];
  const add = () => {
    if (!newName.trim()) return;
    const name = newName.trim();
    const defaultPackageId = BUTTON_PACKAGES[0]?.id || 'pkg-1';
    onChange([
      ...books,
      normalizeBook({
        id: uid(),
        publisherId: selPubId,
        name,
        description: '',
        buttonPackageId: defaultPackageId,
        previewDocument: createBookPreviewDocument(name, defaultPackageId),
      }),
    ]);
    setNewName('');
    setShowModal(false);
  };
  const remove = (id) => onChange(books.filter((b) => b.id !== id));
  const save = (id) => {
    onChange(books.map((b) => (b.id === id ? { ...b, name: editName.trim() || b.name } : b)));
    setEditId(null);
  };
  const prepareBookAction = useCallback(
    async (bookId) => {
      if (selId === bookId) return true;
      const changed = await onSelect(bookId);
      return changed !== false;
    },
    [onSelect, selId]
  );

  const handlePdfImport = async (file) => {
    if (!file) return;
    if (!selId) {
      alert('Once PDF eklemek istedigin kitabi sec.');
      return;
    }
    const importLogs = [];
    const logProgress = (message, tone = 'info') =>
      appendPdfImportLog(importLogs, pushPdfStatus(message, tone));
    setPdfBusy(true);
    setPdfStatusOpen(true);
    setPdfError('');
    setPdfLogs([]);
    logProgress('PDF analiz baslatildi...', 'info');
    try {
      const analysis = await analyzePdfFile(file, logProgress);
      logProgress('Etkinlik taslaklari olusturuluyor...', 'info');
      const result = buildPdfDraftActivities(selId, analysis);
      logProgress(`${result.activities.length} etkinlik taslagi hazirlandi.`, 'success');
      const record = { ...result.record, logs: importLogs.slice(-40) };
      onActivitiesChange([...(activities || []), ...result.activities]);
      onChange(
        books.map((book) =>
          book.id === selId ? { ...book, pdfImports: [...(book.pdfImports || []), record] } : book
        )
      );
    } catch (error) {
      const message = error.message || 'PDF analizi basarisiz oldu.';
      setPdfError(message);
      logProgress(message, 'error');
    } finally {
      setPdfBusy(false);
      if (pdfInputRef.current) pdfInputRef.current.value = '';
    }
  };

  if (!selPubId)
    return (
      <div style={{ fontSize: 10, color: '#444', textAlign: 'center', padding: 8 }}>
        Yayınevi seçin
      </div>
    );
  return (
    <>
      <PdfImportStatusModal
        open={pdfStatusOpen}
        busy={pdfBusy}
        message={pdfMessage}
        error={pdfError}
        logs={pdfLogs}
        onClose={() => setPdfStatusOpen(false)}
      />
      <SelectionGridLayout
        search={search}
        onSearchChange={setSearch}
        addLabel="Yeni Kitap Ekle"
        onAdd={() => setShowModal(true)}
        toolbarExtras={
          <>
            <input
              ref={pdfInputRef}
              type="file"
              accept="application/pdf,.pdf"
              style={{ display: 'none' }}
              onChange={(e) => handlePdfImport(e.target.files?.[0])}
            />
            <button
              onClick={() => pdfInputRef.current?.click()}
              disabled={!selId || pdfBusy}
              title={!selId ? 'Once bir kitap sec' : 'PDF dosyasi ekle'}
              style={{
                minWidth: 210,
                height: 58,
                borderRadius: 16,
                border: `1px solid ${!selId ? '#fed7aa' : '#bfe2f8'}`,
                background: !selId
                  ? 'linear-gradient(135deg,#fff7ed,#ffffff)'
                  : pdfBusy
                    ? '#eef7ff'
                    : 'linear-gradient(135deg,#f2faff,#ffffff)',
                color: !selId ? '#c2410c' : '#0f5d8e',
                fontSize: 13,
                fontWeight: 800,
                cursor: !selId || pdfBusy ? 'default' : 'pointer',
                boxShadow: '0 12px 28px rgba(14,165,233,.12)',
                opacity: !selId || pdfBusy ? 0.72 : 1,
              }}
            >
              {pdfBusy ? 'PDF Çözümleniyor...' : !selId ? 'Once Kitap Sec' : 'PDF Iceri Al'}
            </button>
          </>
        }
      >
        <SelectionGridCards
          items={searched}
          selectedId={selId}
          onSelect={onSelect}
          onEdit={async (item) => {
            const allowed = await prepareBookAction(item.id);
            if (!allowed) return;
            setEditId(item.id);
            setEditName(item.name);
          }}
          onDelete={async (id) => {
            const allowed = await prepareBookAction(id);
            if (!allowed) return;
            remove(id);
          }}
          emptyText="Kitap ekleyin."
        />
      </SelectionGridLayout>

      {(!selId || pdfBusy || pdfError || selectedBookImports.length > 0) && (
        <div style={{ marginTop: 14, ...createLightPanelStyle({ padding: 16 }), borderRadius: 22 }}>
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: 10,
              marginBottom: 10,
              flexWrap: 'wrap',
            }}
          >
            <div style={{ fontSize: 13, fontWeight: 800, color: EDITOR_THEME.lightText }}>
              PDF Otomasyon Sonuclari
            </div>
            {selectedBook ? (
              <div style={{ fontSize: 11, color: EDITOR_THEME.lightMuted }}>
                {selectedBook.name}
              </div>
            ) : (
              <div style={{ fontSize: 11, color: '#b45309' }}>
                PDF iceri almak icin once bir kitap sec.
              </div>
            )}
          </div>
          {!selId && (
            <div
              style={{
                fontSize: 11,
                color: '#92400e',
                background: '#fffbeb',
                border: '1px solid #fde68a',
                borderRadius: 12,
                padding: '10px 12px',
                marginBottom: 8,
              }}
            >
              Sol taraftan bir kitap secildiginde PDF Iceri Al butonu aktif olur.
            </div>
          )}
          {pdfBusy && (
            <div style={{ fontSize: 11, color: '#4338ca', marginBottom: 8 }}>
              {pdfMessage || 'PDF analiz ediliyor...'}
            </div>
          )}
          {!pdfBusy && !pdfError && pdfMessage && (
            <div
              style={{
                fontSize: 11,
                color: '#0f766e',
                background: '#ecfeff',
                border: '1px solid #a5f3fc',
                borderRadius: 12,
                padding: '8px 10px',
                marginBottom: 8,
              }}
            >
              {pdfMessage}
            </div>
          )}
          {pdfError && (
            <div style={{ fontSize: 11, color: '#b91c1c', marginBottom: 8 }}>{pdfError}</div>
          )}
          {selectedBookImports.length > 0 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
              {[...selectedBookImports]
                .slice()
                .reverse()
                .map((importItem) => (
                  <div
                    key={importItem.id}
                    style={{
                      border: `1px solid ${EDITOR_THEME.lightBorder}`,
                      borderRadius: 18,
                      padding: 12,
                      background: '#ffffff',
                      boxShadow: '0 8px 18px rgba(15,23,42,.05)',
                    }}
                  >
                    <div
                      style={{
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between',
                        gap: 10,
                        marginBottom: 8,
                        flexWrap: 'wrap',
                      }}
                    >
                      <div style={{ fontSize: 12, fontWeight: 800, color: EDITOR_THEME.lightText }}>
                        {importItem.fileName}
                      </div>
                      <div style={{ fontSize: 10, color: EDITOR_THEME.lightMuted }}>
