function uid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
}

function createTimelineKeyframe(time = 0, index = 0) {
  return {
    id: uid(),
    name: `Kare ${index + 1}`,
    time,
    x: 0,
