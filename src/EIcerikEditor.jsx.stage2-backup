        const [start, end] = gradients[index % gradients.length];
        const isSelected = selectedId === item.id;
        const initial = (item.name || '?').trim().charAt(0).toUpperCase() || '?';
        return (
          <div key={item.id} style={{ position: 'relative' }}>
