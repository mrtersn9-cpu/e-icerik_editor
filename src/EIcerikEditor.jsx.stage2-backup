                      cursor: 'pointer',
                      boxShadow: '0 8px 18px rgba(15,23,42,.08)',
                    }}
                  >
                    {action.label}
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {/* ─── Tam Ekran Canvas Düzenleme Katmanı ──────────────────────────── */}
      {canvasExpanded && selActivity && currentView === 'editor' && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 900,
            display: 'flex',
            flexDirection: 'column',
            background: '#161e30',
          }}
        >
          <div
            style={{
              minHeight: 52,
              flexShrink: 0,
              background: '#1e2740',
              borderBottom: '1px solid #131b2e',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              padding: '8px 14px',
              gap: 12,
              flexWrap: 'wrap',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', gap: 10, flexWrap: 'wrap' }}>
              <span style={{ fontSize: 12, fontWeight: 700, color: '#cbd5e1' }}>
                {selActivity.sceneName || selActivity.name || 'Sahne'}
              </span>
              <span style={{ fontSize: 9, color: '#64748b', fontFamily: 'monospace' }}>
                {selActivity.stageWidth} × {selActivity.stageHeight}
              </span>
              <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                {renderEditorTabButtons((tab) => ({
                  padding: '6px 10px',
                  border: `1px solid ${activeTab === tab.id ? 'rgba(125,211,252,.45)' : 'rgba(255,255,255,.12)'}`,
                  borderRadius: 8,
                  background:
                    activeTab === tab.id ? 'rgba(14,165,233,.16)' : 'rgba(255,255,255,.04)',
                  color: activeTab === tab.id ? '#d7f3ff' : '#94a3b8',
                  fontSize: 10,
                  fontWeight: 800,
                  cursor: 'pointer',
                }))}
              </div>
            </div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>
              <div
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 3,
                  background: 'rgba(255,255,255,.07)',
                  border: '1px solid rgba(255,255,255,.12)',
                  borderRadius: 6,
                  padding: '3px 7px',
                }}
              >
                <button
                  onClick={() => adjustStageZoom(-0.1)}
                  style={{
                    background: 'none',
                    border: 'none',
                    color: '#94a3b8',
                    cursor: 'pointer',
                    fontSize: 13,
                    padding: '0 2px',
                    lineHeight: 1,
                  }}
                >
                  −
                </button>
                <span
                  style={{
                    fontSize: 10,
                    color: '#cbd5e1',
                    minWidth: 56,
                    textAlign: 'center',
                    fontWeight: 700,
                  }}
                >
                  {zoom === 'fit' ? `Sığdır ${currentZoomPercent}%` : `${currentZoomPercent}%`}
                </span>
                <button
                  onClick={() => adjustStageZoom(0.1)}
                  style={{
                    background: 'none',
                    border: 'none',
                    color: '#94a3b8',
                    cursor: 'pointer',
                    fontSize: 13,
                    padding: '0 2px',
                    lineHeight: 1,
                  }}
                >
                  +
                </button>
                <button
                  onClick={() => setZoom('fit')}
                  style={{
                    background: 'rgba(99,131,255,.2)',
                    border: '1px solid rgba(99,131,255,.35)',
                    color: '#a5b4fc',
                    cursor: 'pointer',
                    fontSize: 9,
                    padding: '2px 6px',
                    borderRadius: 4,
                  }}
                >
                  Sığdır
                </button>
                <button
                  onClick={() => setZoom(1)}
                  style={{
                    background: 'rgba(255,255,255,.06)',
                    border: '1px solid rgba(255,255,255,.12)',
                    color: '#94a3b8',
                    cursor: 'pointer',
                    fontSize: 9,
                    padding: '2px 6px',
                    borderRadius: 4,
                  }}
                >
                  1:1
                </button>
              </div>
              <button
                onClick={() => setCanvasExpanded(false)}
                title="Küçült (Esc)"
                style={{
                  height: 30,
                  padding: '0 12px',
                  borderRadius: 6,
                  border: '1px solid rgba(248,113,113,.35)',
                  background: 'rgba(248,113,113,.12)',
                  color: '#fca5a5',
                  fontSize: 11,
                  fontWeight: 700,
                  cursor: 'pointer',
                  display: 'flex',
                  alignItems: 'center',
                  gap: 5,
                }}
              >
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                  <path
                    d="M1 1L9 9M9 1L1 9"
                    stroke="#fca5a5"
                    strokeWidth="1.5"
                    strokeLinecap="round"
                  />
                </svg>
                Küçült
              </button>
            </div>
          </div>
          {renderEditorRibbon({ fullscreen: true })}
          <div
            style={{
              flex: 1,
              minHeight: 0,
              display: 'flex',
              overflow: 'hidden',
              background: '#6b7280',
              padding: 14,
              gap: 14,
            }}
          >
            <div
              style={{
                flex: 1,
                minWidth: 0,
                minHeight: 0,
                display: 'flex',
                flexDirection: 'column',
                gap: 10,
              }}
            >
              <div
                style={{
                  flex: 1,
                  minHeight: 0,
                  display: 'flex',
                  overflow: 'hidden',
                  background: EDITOR_THEME.appCanvas,
                  borderRadius: 22,
                  padding: 18,
                  boxShadow: 'inset 0 1px 0 rgba(255,255,255,.05)',
                }}
              >
                <StageCanvas
                  ref={canvasRef}
                  activity={selActivity}
                  onUpdate={updateActivity}
                  zoom={zoom}
                  onZoomChange={setZoom}
                  selectedIds={selectedIds}
                  onSelectionChange={setSelectedIds}
                  timelineTime={timelineCurrentTime}
                  answerPreview={answerPreview}
                />
              </div>
              <div style={{ flexShrink: 0, overflow: 'hidden', borderRadius: 18 }}>
                <TimelineDock
                  activity={selActivity}
                  onUpdate={updateActivity}
                  height={Math.min(Math.max(timelineHeight, 220), 340)}
                  currentTime={timelineCurrentTime}
                  onCurrentTimeChange={setTimelineCurrentTime}
                  isPlaying={timelinePlaying}
                  onPlayingChange={setTimelinePlaying}
                  selectedIds={selectedIds}
                  onSelectObject={(objectId) => {
                    if (!objectId) return;
                    setSelectedIds(new Set([objectId]));
                    if (selActivity) updateActivity({ ...selActivity, selectedObjectId: objectId });
                  }}
                />
              </div>
            </div>
            <div
              style={{
                width: Math.max(368, rightPanelWidth),
                minWidth: Math.max(368, rightPanelWidth),
                maxWidth: Math.max(368, rightPanelWidth),
                minHeight: 0,
                display: 'flex',
                flexDirection: 'row',
                ...createShellPanelStyle(),
                borderRadius: 22,
                overflow: 'hidden',
              }}
            >
              <EditorToolRail
                selActivity={selActivity}
                canvasRef={canvasRef}
                selectedIds={selectedIds}
                setActiveTab={handleEditorTabSelect}
                previewMode={previewMode}
                setPreviewMode={setPreviewMode}
                uiMode={uiMode}
              />
              <div style={{ flex: 1, minWidth: 0, overflow: 'hidden' }}>
                <RightInspectorPhase2
                  activity={selActivity}
                  onUpdate={updateActivity}
                  selectedIds={selectedIds}
                  activities={present.activities}
                  variables={present.variables}
                  onVariablesChange={(nextVariables) =>
                    commit((p) => ({ ...p, variables: nextVariables }))
                  }
                  hideTimeline
                  uiMode={uiMode}
                  onAnswerPreviewChange={setAnswerPreview}
                />
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ─── Tam Ekran Önizleme Katmanı ─────────────────────────────────── */}
      {previewMode && selActivity && currentView === 'editor' && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 1000,
            overflow: 'hidden',
            background: '#0a0f1e',
            display: 'flex',
            flexDirection: 'column',
          }}
        >
          {/* Sticky exit bar */}
          <div
            style={{
              position: 'sticky',
              top: 0,
              zIndex: 10,
              background: 'rgba(10,15,30,.96)',
              backdropFilter: 'blur(20px)',
              WebkitBackdropFilter: 'blur(20px)',
              borderBottom: '1px solid rgba(255,255,255,.07)',
              padding: '10px 20px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: 12,
              flexShrink: 0,
              height: 50,
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
              <div
                style={{
                  width: 8,
                  height: 8,
                  borderRadius: '50%',
                  background: '#22c55e',
                  boxShadow: '0 0 0 3px rgba(34,197,94,.18)',
                }}
              />
              <span
                style={{
                  color: 'rgba(255,255,255,.6)',
                  fontSize: 12,
                  fontWeight: 700,
                  letterSpacing: 0.4,
                }}
              >
                Öğrenci Görünümü
              </span>
              {selActivity?.name && (
                <>
                  <span style={{ color: 'rgba(255,255,255,.18)', fontSize: 10 }}>·</span>
                  <span style={{ color: 'rgba(255,255,255,.36)', fontSize: 11 }}>
                    {selActivity.name}
                  </span>
                </>
              )}
            </div>
            <button
              onClick={() => setPreviewMode(false)}
              style={{
                padding: '7px 18px',
                borderRadius: 999,
                border: '1px solid rgba(255,255,255,.14)',
                background: 'rgba(255,255,255,.06)',
                color: 'rgba(255,255,255,.82)',
                fontSize: 11,
                fontWeight: 700,
                cursor: 'pointer',
                letterSpacing: 0.3,
                transition: 'background .15s',
              }}
            >
              ← Editöre Dön
            </button>
          </div>
          {/* Content Wrapper */}
          <div
            style={{
              flex: 1,
              position: 'relative',
              width: '100%',
              overflow: 'hidden',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
            }}
            ref={(containerNode) => {
              if (!containerNode) return;
              // ResizeObserver to calculate scale
              const contentNode = containerNode.firstChild;
              if (!contentNode) return;

              const resizeObserver = new ResizeObserver((entries) => {
                for (let entry of entries) {
                  const cw = entry.contentRect.width;
                  const ch = entry.contentRect.height;

                  // Use a fixed virtual resolution or the actual content width/height.
                  // For PreviewPlayer, we might assume a max-width of around 1100 or actual size.
                  // Since PreviewPlayer doesn't have a fixed size, we wrap it in a container that
                  // fits its content and scale that container.
                  const contentW = contentNode.offsetWidth || 1100;
                  const contentH = contentNode.offsetHeight || 760;

                  // Calculate scale to fit both width and height (with some padding)
                  const scaleW = cw / (contentW + 40); // 40px padding
                  const scaleH = ch / (contentH + 40);
                  const scale = Math.min(scaleW, scaleH, 1); // Don't scale up beyond 1

                  contentNode.style.transform = `scale(${scale})`;
                }
              });
              resizeObserver.observe(containerNode);
              return () => resizeObserver.disconnect();
            }}
          >
            <div
              style={{ transformOrigin: 'center center', transition: 'transform 0.1s ease-out' }}
            >
              <PreviewPlayer
                activity={selActivity}
                activities={present.activities}
                variables={present.variables}
              />
            </div>
          </div>
        </div>
      )}

      <ProjectVersionManagerModal
        open={showProjectManager}
        onClose={() => setShowProjectManager(false)}
        dbStatus={dbStatus}
        currentProject={currentProject}
        projectNameDraft={projectNameDraft}
        onProjectNameChange={setProjectNameDraft}
        newProjectName={newProjectName}
        onNewProjectNameChange={setNewProjectName}
        onCreateProject={handleCreateProject}
        projects={workspaceInfo.projects}
        onSwitchProject={handleSwitchProject}
        onDeleteProject={handleDeleteProject}
        versionLabel={versionLabel}
        onVersionLabelChange={setVersionLabel}
        onCreateVersion={handleCreateVersion}
        onPublishVersion={handlePublishExistingVersion}
        versions={workspaceInfo.versions}
        onRestoreVersion={handleRestoreVersion}
        onSaveProjectName={handleSaveProjectName}
        onDeleteVersion={handleDeleteVersion}
        onDuplicateProject={handleDuplicateProject}
        activityCount={present.activities.length}
        currentProjectId={currentProjectId}
        books={present.books.map((book) => ({
          id: book.id,
          name: book.name,
          activityCount: present.activities.filter((a) => a.bookId === book.id).length,
        }))}
      />
    </div>
  );
}
