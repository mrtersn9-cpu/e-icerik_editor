                  style={{
                    display: 'flex',
                    alignItems: 'flex-start',
                    justifyContent: 'space-between',
                    gap: 8,
                    marginBottom: 8,
                  }}
                >
                  <div style={{ minWidth: 0, flex: 1 }}>
                    <div
                      style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}
                    >
                      <span
                        style={{
                          padding: '3px 7px',
                          borderRadius: 999,
                          background: `${accent}18`,
                          color: accent,
                          border: `1px solid ${accent}44`,
                          fontSize: 9,
                          fontWeight: 800,
                        }}
                      >
                        Trigger {index + 1}
                      </span>
                      <span style={{ fontSize: 11, fontWeight: 800, color: '#0f172a' }}>
                        {describeTrigger(item)}
                      </span>
                    </div>
                    <div style={{ fontSize: 9, color: '#64748b', marginTop: 4 }}>
                      {item.name || 'Kosullu aksiyon satiri'}
                    </div>
                  </div>
                  <button
                    onClick={() => patchAct({ triggers: triggers.filter((x) => x.id !== item.id) })}
                    style={{
                      border: 'none',
                      background: 'transparent',
                      color: '#ef4444',
                      cursor: 'pointer',
                      fontSize: 14,
                      lineHeight: 1,
                    }}
                  >
                    ×
                  </button>
                </div>

                <div
                  style={{
                    display: 'grid',
                    gridTemplateColumns: '62px 1fr 42px 1fr 42px 1fr',
                    gap: 6,
                    alignItems: 'end',
                  }}
                >
                  <div style={{ fontSize: 9, fontWeight: 800, color: '#64748b', paddingBottom: 6 }}>
                    When
                  </div>
                  <SelectInp
                    value={item.when || 'onClick'}
                    onChange={(e) =>
                      patchTrigger(item.id, {
                        when: e.target.value,
                        target:
                          e.target.value === 'onLoad'
                            ? '__activity__'
                            : item.target || 'Secili Nesne',
                      })
                    }
                    options={TRIGGER_WHEN_OPTIONS}
                  />
                  <div style={{ fontSize: 9, fontWeight: 800, color: '#64748b', paddingBottom: 6 }}>
                    On
                  </div>
                  <SelectInp
                    value={item.target || 'Secili Nesne'}
                    onChange={(e) => patchTrigger(item.id, { target: e.target.value })}
                    options={
                      item.when === 'onLoad'
                        ? [{ value: '__activity__', label: 'Sahne / yukleme' }]
                        : triggerSourceOptions
                    }
                  />
                  <div style={{ fontSize: 9, fontWeight: 800, color: '#64748b', paddingBottom: 6 }}>
                    Do
                  </div>
                  <SelectInp
                    value={item.action || 'SayfaGec'}
                    onChange={(e) =>
                      patchTrigger(item.id, {
                        action: e.target.value,
                        value:
                          e.target.value === 'KatmanaGec'
                            ? layers[0]?.id || 'base'
                            : e.target.value === 'SliderGec'
                              ? '__next__'
                              : e.target.value === 'SayfaGec'
                                ? '__next__'
                                : e.target.value === 'Goster' ||
                                    e.target.value === 'Gizle' ||
                                    e.target.value === 'NesneDurumuAyarla'
                                  ? objects[0]?.id || ''
                                  : e.target.value === 'DegiskenAta' ||
                                      e.target.value === 'DegiskenArttir' ||
                                      e.target.value === 'DegiskenAzalt'
                                    ? variables[0]?.id || ''
                                    : item.value || '',
                        extra:
                          e.target.value === 'DegiskenArttir' || e.target.value === 'DegiskenAzalt'
                            ? '1'
                            : item.extra || '',
                        stateKey:
                          e.target.value === 'NesneDurumuAyarla'
                            ? 'visited'
                            : item.stateKey || 'visited',
                        stateValue:
                          e.target.value === 'NesneDurumuAyarla'
                            ? 'true'
                            : item.stateValue || 'true',
                      })
                    }
                    options={TRIGGER_ACTION_OPTIONS}
                  />
                </div>

                <div
                  style={{
                    display: 'grid',
                    gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))',
                    gap: 6,
                    marginTop: 8,
                  }}
                >
                  <Inp
                    label="Ad"
                    value={item.name || ''}
                    onChange={(e) => patchTrigger(item.id, { name: e.target.value })}
                    placeholder="Kosullu gecis"
                  />
                  {item.action === 'KatmanaGec' ? (
                    <SelectInp
                      label="Hedef Katman"
                      value={item.value || layers[0]?.id || 'base'}
                      onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                      options={triggerLayerOptions}
                    />
                  ) : item.action === 'SliderGec' ? (
                    <SelectInp
                      label="Hedef Slider"
                      value={item.value || '__next__'}
                      onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                      options={triggerSlideOptions}
                    />
                  ) : item.action === 'SayfaGec' ? (
                    <SelectInp
                      label="Hedef Sahne"
                      value={item.value || '__next__'}
                      onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                      options={
                        triggerActivityOptions.length
                          ? triggerActivityOptions
                          : [{ value: '__next__', label: 'Sonraki sahne' }]
                      }
                    />
                  ) : item.action === 'Goster' || item.action === 'Gizle' ? (
                    <SelectInp
                      label="Etkilenecek Nesne"
                      value={item.value || ''}
                      onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                      options={
                        triggerTargetOptions.length
                          ? triggerTargetOptions
                          : [{ value: '', label: 'Nesne yok' }]
                      }
                    />
                  ) : item.action === 'DegiskenAta' ? (
                    <>
                      <SelectInp
                        label="Degisken"
                        value={item.value || ''}
                        onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                        options={
                          variableOptions.length
                            ? variableOptions
                            : [{ value: '', label: 'Degisken yok' }]
                        }
                      />
                      <Inp
                        label="Yeni Deger"
                        value={item.extra || ''}
                        onChange={(e) => patchTrigger(item.id, { extra: e.target.value })}
                      />
                    </>
                  ) : item.action === 'DegiskenArttir' || item.action === 'DegiskenAzalt' ? (
                    <>
                      <SelectInp
                        label="Degisken"
                        value={item.value || ''}
                        onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                        options={
                          variableOptions.length
                            ? variableOptions
                            : [{ value: '', label: 'Degisken yok' }]
                        }
                      />
                      <Inp
                        label="Miktar"
                        type="number"
                        value={item.extra || '1'}
                        onChange={(e) => patchTrigger(item.id, { extra: e.target.value })}
                      />
                    </>
                  ) : item.action === 'NesneDurumuAyarla' ? (
                    <>
                      <SelectInp
                        label="Nesne"
                        value={item.value || ''}
                        onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                        options={
                          objectStateOptions.length
                            ? objectStateOptions
                            : [{ value: '', label: 'Nesne yok' }]
                        }
                      />
                      <SelectInp
                        label="Durum"
                        value={item.stateKey || 'visited'}
                        onChange={(e) => patchTrigger(item.id, { stateKey: e.target.value })}
                        options={OBJECT_STATE_OPTIONS}
                      />
                      <SelectInp
                        label="Deger"
                        value={String(item.stateValue ?? 'true')}
                        onChange={(e) => patchTrigger(item.id, { stateValue: e.target.value })}
                        options={boolOptions}
                      />
                    </>
                  ) : (
                    <Inp
                      label="Deger"
                      value={item.value || ''}
                      onChange={(e) => patchTrigger(item.id, { value: e.target.value })}
                    />
                  )}
                </div>

                <details open={conditionCount > 0} style={{ marginTop: 8 }}>
                  <summary
                    style={{
                      cursor: 'pointer',
                      listStyle: 'none',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      gap: 8,
                      fontSize: 10,
                      fontWeight: 800,
                      color: '#334155',
                    }}
                  >
                    <span>Kosullar {conditionCount ? `(${conditionCount})` : ''}</span>
                    <span style={{ fontSize: 9, color: '#64748b' }}>
                      {getOptionLabel(triggerModeOptions, item.conditionMode || 'all', 'Tumu')}
                    </span>
                  </summary>
                  <div style={{ borderTop: '1px solid #e2e8f0', paddingTop: 8, marginTop: 6 }}>
                    <div
                      style={{
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between',
                        gap: 6,
                        marginBottom: 6,
                      }}
                    >
                      <SelectInp
                        value={item.conditionMode || 'all'}
                        onChange={(e) => patchTrigger(item.id, { conditionMode: e.target.value })}
                        options={triggerModeOptions}
                      />
                      <button
                        onClick={() =>
                          patchTriggerConditions(item.id, (prev) => [
                            ...prev,
                            createTriggerConditionItem(prev.length),
                          ])
                        }
                        style={{
                          minHeight: 28,
                          padding: '0 10px',
                          borderRadius: 8,
                          border: '1px solid #cbd5e1',
                          background: '#ffffff',
                          color: '#2563eb',
                          fontSize: 10,
                          fontWeight: 800,
                          cursor: 'pointer',
                        }}
                      >
                        + Kosul
                      </button>
                    </div>
                    {(item.conditions || []).map((condition) => (
                      <div
                        key={condition.id}
                        style={{
                          background: '#ffffff',
                          border: '1px solid #dbe7f5',
                          borderRadius: 10,
                          padding: 6,
                          marginBottom: 6,
                        }}
                      >
                        <div
                          style={{ display: 'flex', gap: 5, alignItems: 'center', marginBottom: 5 }}
                        >
                          <SelectInp
                            value={condition.sourceType || 'variable'}
                            onChange={(e) =>
                              patchTriggerConditions(item.id, (prev) =>
                                prev.map((entry) =>
                                  entry.id === condition.id
                                    ? { ...entry, sourceType: e.target.value, sourceId: '' }
                                    : entry
                                )
                              )
                            }
                            options={[
                              { value: 'variable', label: 'Degisken' },
                              { value: 'objectState', label: 'Nesne Durumu' },
                            ]}
                          />
                          <button
                            onClick={() =>
                              patchTriggerConditions(item.id, (prev) =>
                                prev.filter((entry) => entry.id !== condition.id)
                              )
                            }
                            style={{
                              border: 'none',
                              background: 'transparent',
                              color: '#ef4444',
                              cursor: 'pointer',
                              fontSize: 12,
                            }}
                          >
                            ×
                          </button>
                        </div>
                        <div
                          style={{
                            display: 'grid',
                            gridTemplateColumns: 'repeat(auto-fit, minmax(130px, 1fr))',
                            gap: 5,
                          }}
                        >
                          <SelectInp
                            label={condition.sourceType === 'objectState' ? 'Nesne' : 'Degisken'}
                            value={condition.sourceId || ''}
                            onChange={(e) =>
                              patchTriggerConditions(item.id, (prev) =>
                                prev.map((entry) =>
                                  entry.id === condition.id
                                    ? { ...entry, sourceId: e.target.value }
                                    : entry
                                )
                              )
                            }
                            options={
                              (condition.sourceType === 'objectState'
                                ? objectStateOptions
                                : variableOptions
                              ).length
                                ? condition.sourceType === 'objectState'
                                  ? objectStateOptions
                                  : variableOptions
                                : [{ value: '', label: 'Kaynak yok' }]
                            }
                          />
                          {condition.sourceType === 'objectState' && (
                            <SelectInp
                              label="Durum"
                              value={condition.stateKey || 'visited'}
                              onChange={(e) =>
                                patchTriggerConditions(item.id, (prev) =>
                                  prev.map((entry) =>
                                    entry.id === condition.id
                                      ? { ...entry, stateKey: e.target.value }
                                      : entry
                                  )
                                )
                              }
                              options={OBJECT_STATE_OPTIONS}
                            />
                          )}
                          <SelectInp
                            label="Operator"
                            value={condition.operator || 'eq'}
                            onChange={(e) =>
                              patchTriggerConditions(item.id, (prev) =>
                                prev.map((entry) =>
                                  entry.id === condition.id
                                    ? { ...entry, operator: e.target.value }
                                    : entry
                                )
                              )
                            }
                            options={TRIGGER_OPERATOR_OPTIONS}
                          />
                          {!['truthy', 'falsy'].includes(condition.operator || 'eq') && (
                            <Inp
                              label="Karsilastirma"
                              value={condition.value || ''}
                              onChange={(e) =>
                                patchTriggerConditions(item.id, (prev) =>
                                  prev.map((entry) =>
                                    entry.id === condition.id
                                      ? { ...entry, value: e.target.value }
                                      : entry
                                  )
                                )
                              }
                            />
                          )}
                        </div>
                      </div>
                    ))}
                    {(!item.conditions || item.conditions.length === 0) && (
                      <div
                        style={{
                          fontSize: 10,
                          color: '#64748b',
                          textAlign: 'center',
                          padding: '8px 0',
                        }}
                      >
                        Kosul yok, trigger her zaman calisir
                      </div>
                    )}
                  </div>
                </details>
              </div>
            );
          })}
          {triggers.length === 0 && (
            <div style={{ fontSize: 10, color: '#64748b', textAlign: 'center', padding: '8px 0' }}>
              Tetikleyici yok. Yeni satir ekleyerek Articulate mantiginda akis kurabilirsin.
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function TimelineDock({
  activity,
  onUpdate,
  height = 230,
  currentTime = 0,
  onCurrentTimeChange = () => {},
  isPlaying = false,
  onPlayingChange = () => {},
  selectedIds = new Set(),
  onSelectObject = () => {},
}) {
  if (!activity) {
    return (
      <div
        style={{
          height,
          borderTop: `1px solid ${EDITOR_THEME.shellBorder}`,
          background: `linear-gradient(180deg, ${EDITOR_THEME.shellPanelAlt}, ${EDITOR_THEME.shellBg})`,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          color: EDITOR_THEME.shellMutedSoft,
          fontSize: 12,
        }}
      >
        Timeline burada görünecek.
      </div>
    );
  }

  const timeline = getActivityTimeline(activity);
  const objects = activity.objects || [];
  const patchAct = (p) => onUpdate({ ...activity, ...p });
  const patchTimeline = (id, p) =>
    patchAct({ timeline: timeline.map((item) => (item.id === id ? { ...item, ...p } : item)) });
  const patchTimelineKeyframes = (timelineId, updater) => {
    const clip = timeline.find((item) => item.id === timelineId);
    if (!clip) return;
    const currentKeyframes = Array.isArray(clip.keyframes) ? clip.keyframes : [];
    const nextKeyframes = typeof updater === 'function' ? updater(currentKeyframes) : updater;
    patchTimeline(timelineId, { keyframes: nextKeyframes });
  };
  const [timelineZoom, setTimelineZoom] = useState(84);
  const pixelsPerSecond = timelineZoom;
  const labelColumnWidth = 236;
  const rowHeight = 56;
  const totalDuration = Math.max(5, getTimelineDuration(activity));
  const trackWidth = Math.max(900, Math.round(totalDuration * pixelsPerSecond) + 64);
  const dragRef = useRef(null);
  const objectTypeIcons = {
    text: 'T',
    button: 'B',
    shape: '■',
    image: 'I',
    video: 'V',
    audio: '♪',
    hotspot: '◎',
    draggable: '↕',
    dropzone: '▭',
    default: '•',
  };
  const zoomPercent = Math.round((timelineZoom / 84) * 100);
  const timelineTicks = Array.from({ length: Math.ceil(totalDuration * 5) + 1 }, (_, index) => {
    const second = index / 5;
    return { second, left: second * pixelsPerSecond, major: index % 5 === 0 };
  });
  const activeTimelineItem =
    timeline.find(
      (item) => selectedIds.has(item.objectId) || activity.selectedObjectId === item.objectId
    ) ||
    timeline[0] ||
    null;
  const activeObject = activeTimelineItem
    ? objects.find((entry) => entry.id === activeTimelineItem.objectId) || null
    : null;
  const activeLabel =
    activeObject?.label || activeObject?.type || activeTimelineItem?.name || 'Klip';
  const activeKeyframes = Array.isArray(activeTimelineItem?.keyframes)
    ? activeTimelineItem.keyframes
    : [];
  const currentSeconds = Number(currentTime || 0).toFixed(1);
  const timelineCard = {
    borderRadius: 12,
    border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
    background: 'rgba(255,255,255,.035)',
    boxShadow: 'inset 0 1px 0 rgba(255,255,255,.03)',
  };
  const toolbarButton = {
    minHeight: 30,
    padding: '0 12px',
    borderRadius: 10,
    border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
    background: 'rgba(255,255,255,.06)',
    color: EDITOR_THEME.shellMuted,
    fontSize: 10,
    fontWeight: 800,
    cursor: 'pointer',
    boxShadow: 'inset 0 1px 0 rgba(255,255,255,.04)',
  };
  const compactField = {
    display: 'flex',
    flexDirection: 'column',
    gap: 4,
    minWidth: 0,
  };
  const compactInput = {
    width: '100%',
    minHeight: 32,
    padding: '0 9px',
    borderRadius: 10,
    border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
    background: '#0e1728',
    color: EDITOR_THEME.shellMuted,
    fontSize: 10,
    boxSizing: 'border-box',
    outline: 'none',
  };

  useEffect(
    () => () => {
      if (!dragRef.current) return;
      window.removeEventListener('pointermove', dragRef.current.move);
      window.removeEventListener('pointerup', dragRef.current.up);
    },
    []
  );

  const beginClipDrag = (event, item, mode) => {
    event.preventDefault();
    event.stopPropagation();
    const session = {
      id: item.id,
      mode,
      startX: event.clientX,
      start: Number(item.start || 0),
      duration: Number(item.duration || 0.2),
    };
    const move = (moveEvent) => {
      const deltaSeconds = (moveEvent.clientX - session.startX) / pixelsPerSecond;
      if (session.mode === 'move') {
        patchTimeline(session.id, {
          start: Math.max(0, Number((session.start + deltaSeconds).toFixed(1))),
        });
        return;
      }
      if (session.mode === 'resize-start') {
        const nextStart = clamp(
          Number((session.start + deltaSeconds).toFixed(1)),
          0,
          session.start + session.duration - 0.2
        );
        const nextDuration = Math.max(
          0.2,
          Number((session.duration - (nextStart - session.start)).toFixed(1))
        );
        patchTimeline(session.id, { start: nextStart, duration: nextDuration });
        return;
      }
      const nextDuration = Math.max(0.2, Number((session.duration + deltaSeconds).toFixed(1)));
      patchTimeline(session.id, { duration: nextDuration });
    };
    const up = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      dragRef.current = null;
    };
    dragRef.current = { move, up };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };

  const scrubFromPointer = (event) => {
    const rect = event.currentTarget.getBoundingClientRect();
    const nextTime = clamp(
      Number(((event.clientX - rect.left) / pixelsPerSecond).toFixed(1)),
      0,
      totalDuration
    );
    onCurrentTimeChange(nextTime);
  };

  return (
    <div
      style={{
        height,
        borderTop: `1px solid ${EDITOR_THEME.shellBorder}`,
        background: `linear-gradient(180deg, ${EDITOR_THEME.shellPanelAlt}, ${EDITOR_THEME.shellBg})`,
        display: 'flex',
        flexDirection: 'column',
        minHeight: 0,
      }}
    >
      {/* ── Timeline Header ── */}
      <div
        style={{
          minHeight: 54,
          borderBottom: `1px solid ${EDITOR_THEME.shellBorder}`,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          padding: '8px 14px',
          background: 'rgba(255,255,255,.02)',
          gap: 10,
          flexWrap: 'wrap',
          flexShrink: 0,
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: 12, flexWrap: 'wrap' }}>
          <div>
            <div
              style={{
                fontSize: 10,
                fontWeight: 900,
                color: EDITOR_THEME.shellMuted,
                letterSpacing: 0.8,
                textTransform: 'uppercase',
              }}
            >
              Timeline
            </div>
            <div style={{ fontSize: 10, color: EDITOR_THEME.shellMutedSoft, marginTop: 2 }}>
              {currentSeconds}s / {totalDuration.toFixed(1)}s
            </div>
          </div>
          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
            <span
              style={{
                padding: '5px 9px',
                borderRadius: 999,
                border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
                background: 'rgba(255,255,255,.05)',
                fontSize: 9,
                fontWeight: 800,
                color: EDITOR_THEME.shellMuted,
              }}
            >
              {timeline.length} klip
            </span>
            <span
              style={{
                padding: '5px 9px',
                borderRadius: 999,
                border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
                background: 'rgba(255,255,255,.05)',
                fontSize: 9,
                fontWeight: 800,
                color: EDITOR_THEME.shellMuted,
              }}
            >
              {activeKeyframes.length} keyframe
            </span>
          </div>
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>
          <button
            onClick={() => onPlayingChange(!isPlaying)}
            style={{
              ...toolbarButton,
              color: isPlaying ? EDITOR_THEME.shellSuccess : EDITOR_THEME.shellMuted,
              borderColor: isPlaying ? 'rgba(74,222,128,.3)' : EDITOR_THEME.shellBorderSoft,
            }}
          >
            {isPlaying ? '⏸ Duraklat' : '▶ Oynat'}
          </button>
          <button
            onClick={() => {
              onCurrentTimeChange(0);
              onPlayingChange(false);
            }}
            style={toolbarButton}
          >
            ⏮ Başa
          </button>
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 2,
              padding: '3px 4px',
              borderRadius: 10,
              border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
              background: 'rgba(255,255,255,.04)',
            }}
          >
            <button
              onClick={() => setTimelineZoom((value) => clamp(value - 18, 48, 168))}
              style={{
                ...toolbarButton,
                minHeight: 22,
                padding: '0 7px',
                border: 'none',
                background: 'none',
              }}
            >
              −
            </button>
            <span
              style={{
                minWidth: 36,
                textAlign: 'center',
                fontSize: 9,
                fontWeight: 700,
                color: EDITOR_THEME.shellMutedSoft,
              }}
            >
              {zoomPercent}%
            </span>
            <button
              onClick={() => setTimelineZoom((value) => clamp(value + 18, 48, 168))}
              style={{
                ...toolbarButton,
                minHeight: 22,
                padding: '0 7px',
                border: 'none',
                background: 'none',
              }}
            >
              +
            </button>
          </div>
        </div>
      </div>

      {/* ── Active clip inspector ── */}
      {activeTimelineItem && (
        <div
          style={{
            borderBottom: `1px solid ${EDITOR_THEME.shellBorder}`,
            padding: '10px 14px',
            background: 'rgba(255,255,255,.03)',
            flexShrink: 0,
          }}
        >
          <div
            style={{
              display: 'flex',
              gap: 12,
              alignItems: 'flex-start',
              justifyContent: 'space-between',
              flexWrap: 'wrap',
            }}
          >
            <div style={{ minWidth: 180, maxWidth: 260, ...timelineCard, padding: 12 }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>
                <span
                  style={{
                    padding: '4px 8px',
                    borderRadius: 999,
                    background: EDITOR_THEME.shellAccentSoft,
                    color: '#a5e6ff',
                    fontSize: 9,
                    fontWeight: 800,
                    border: `1px solid ${EDITOR_THEME.shellAccentBorder}`,
                  }}
                >
                  Seçili klip
                </span>
                <span style={{ fontSize: 12, fontWeight: 800, color: EDITOR_THEME.shellMuted }}>
                  {activeLabel}
                </span>
              </div>
              <div
                style={{
                  fontSize: 10,
                  color: EDITOR_THEME.shellMutedSoft,
                  marginTop: 6,
                  lineHeight: 1.5,
                }}
              >
                {activeObject?.type ? `${activeObject.type}` : 'Nesne'} ·{' '}
                {shouldObjectPersistAfterTimeline(activeTimelineItem)
                  ? 'kalıcı'
                  : 'çıkış efekti var'}
              </div>
            </div>

            <div
              style={{
                flex: 1,
                minWidth: 380,
                ...timelineCard,
                padding: 12,
                display: 'grid',
                gridTemplateColumns: 'repeat(6, minmax(64px, 1fr))',
                gap: 8,
              }}
            >
              {[
                {
                  label: 'Başlangıç',
                  val: activeTimelineItem.start,
                  key: 'start',
                  onChange: (v) => patchTimeline(activeTimelineItem.id, { start: Math.max(0, v) }),
                },
                {
                  label: 'Süre',
                  val: activeTimelineItem.duration,
                  key: 'duration',
                  onChange: (v) =>
                    patchTimeline(activeTimelineItem.id, { duration: Math.max(0.2, v) }),
                },
              ].map((f) => (
                <label key={f.key} style={compactField}>
                  <span
                    style={{ fontSize: 8, color: EDITOR_THEME.shellMutedSoft, fontWeight: 700 }}
                  >
                    {f.label}
                  </span>
                  <input
                    type="number"
                    value={f.val}
                    onChange={(e) => f.onChange(+e.target.value || 0)}
                    style={compactInput}
                  />
                </label>
              ))}
              {[
                {
                  label: 'Giriş',
                  val: activeTimelineItem.entryEffect || 'fade',
                  key: 'entryEffect',
                  options: TIMELINE_EFFECT_OPTIONS,
                },
                {
                  label: 'Çıkış',
                  val: activeTimelineItem.exitEffect || 'none',
                  key: 'exitEffect',
                  options: TIMELINE_EFFECT_OPTIONS,
                },
                {
                  label: 'Yön',
                  val: activeTimelineItem.direction || 'left',
                  key: 'direction',
                  options: TIMELINE_DIRECTION_OPTIONS,
                },
                {
                  label: 'Easing',
                  val: activeTimelineItem.easing || 'easeOut',
                  key: 'easing',
                  options: TIMELINE_EASING_OPTIONS,
                },
              ].map((f) => (
                <label key={f.key} style={compactField}>
                  <span
                    style={{ fontSize: 8, color: EDITOR_THEME.shellMutedSoft, fontWeight: 700 }}
                  >
                    {f.label}
                  </span>
                  <select
                    value={f.val}
                    onChange={(e) =>
                      patchTimeline(activeTimelineItem.id, { [f.key]: e.target.value })
                    }
                    style={compactInput}
                  >
                    {f.options.map((o) => (
                      <option key={o.value} value={o.value}>
                        {o.label}
                      </option>
                    ))}
                  </select>
                </label>
              ))}
            </div>
          </div>

          {/* Keyframe panel */}
          <div
            style={{
              marginTop: 10,
              padding: '10px 12px',
              borderRadius: 12,
              border: `1px solid ${EDITOR_THEME.shellBorderSoft}`,
              background: '#0d1524',
            }}
          >
            <div
              style={{
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between',
                gap: 8,
                marginBottom: 6,
                flexWrap: 'wrap',
              }}
            >
              <div>
                <span style={{ fontSize: 10, fontWeight: 800, color: EDITOR_THEME.shellMuted }}>
                  Keyframe Noktaları
                </span>
                <span style={{ fontSize: 9, color: EDITOR_THEME.shellMutedSoft, marginLeft: 8 }}>
                  Nesne hareketini düzenle
                </span>
              </div>
              <button
                onClick={() =>
                  patchTimelineKeyframes(activeTimelineItem.id, (prev) => {
                    const nextTime = Math.min(
                      activeTimelineItem.duration,
                      Number(
                        (prev.length
                          ? Math.min(activeTimelineItem.duration, prev[prev.length - 1].time + 0.6)
                          : activeTimelineItem.duration / 2
                        ).toFixed(1)
                      )
                    );
                    return [...prev, createTimelineKeyframe(nextTime, prev.length)];
                  })
                }
                style={{ ...toolbarButton, fontSize: 9 }}
              >
                + Keyframe
              </button>
            </div>
            {activeKeyframes.length > 0 ? (
              <>
                <div style={{ display: 'flex', gap: 4, flexWrap: 'wrap', marginBottom: 6 }}>
                  {activeKeyframes.map((frame, fi) => {
                    const isPinned = fi === 0 || fi === activeKeyframes.length - 1;
                    return (
                      <div
                        key={frame.id}
                        style={{
                          display: 'flex',
                          alignItems: 'center',
                          gap: 5,
                          padding: '2px 7px',
                          borderRadius: 4,
                          border: `1px solid ${isPinned ? 'rgba(99,131,255,.35)' : 'rgba(255,255,255,.08)'}`,
                          background: isPinned ? 'rgba(99,131,255,.1)' : 'rgba(255,255,255,.03)',
                        }}
                      >
                        <strong style={{ fontSize: 9, color: '#818cf8' }}>
                          {Number(frame.time || 0).toFixed(1)}s
                        </strong>
                        <span
                          style={{ fontSize: 8, color: EDITOR_THEME.shellMutedSoft }}
                        >{`X:${Math.round(frame.x || 0)} Y:${Math.round(frame.y || 0)} S:${Number(frame.scale || 1).toFixed(1)} O:${Number(frame.opacity ?? 1).toFixed(1)}`}</span>
                        {!isPinned && activeKeyframes.length > 2 && (
                          <button
                            onClick={() =>
                              patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                                prev.filter((e) => e.id !== frame.id)
                              )
                            }
                            style={{
                              border: 'none',
                              background: 'transparent',
                              color: '#f87171',
                              cursor: 'pointer',
                              fontSize: 11,
                              lineHeight: 1,
                              padding: 0,
                            }}
                          >
                            ×
                          </button>
                        )}
                      </div>
                    );
                  })}
                </div>
                <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                  {activeKeyframes.map((frame, fi) => {
                    const isPinned = fi === 0 || fi === activeKeyframes.length - 1;
                    return (
                      <div
                        key={frame.id}
                        style={{
                          display: 'grid',
                          gridTemplateColumns: '52px 1fr 1fr 1fr 1fr 22px',
                          gap: 3,
                          alignItems: 'center',
                        }}
                      >
                        <input
                          type="number"
                          value={frame.time}
                          onChange={(e) =>
                            patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                              prev.map((en) =>
                                en.id === frame.id
                                  ? {
                                      ...en,
                                      time: clamp(
                                        +e.target.value || 0,
                                        0,
                                        activeTimelineItem.duration
                                      ),
                                    }
                                  : en
                              )
                            )
                          }
                          style={compactInput}
                        />
                        <input
                          type="number"
                          value={frame.x}
                          onChange={(e) =>
                            patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                              prev.map((en) =>
                                en.id === frame.id ? { ...en, x: +e.target.value || 0 } : en
                              )
                            )
                          }
                          placeholder="X"
                          style={compactInput}
                        />
                        <input
                          type="number"
                          value={frame.y}
                          onChange={(e) =>
                            patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                              prev.map((en) =>
                                en.id === frame.id ? { ...en, y: +e.target.value || 0 } : en
                              )
                            )
                          }
                          placeholder="Y"
                          style={compactInput}
                        />
                        <input
                          type="number"
                          step="0.1"
                          value={frame.scale}
                          onChange={(e) =>
                            patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                              prev.map((en) =>
                                en.id === frame.id
                                  ? { ...en, scale: Math.max(0.1, +e.target.value || 1) }
                                  : en
                              )
                            )
                          }
                          placeholder="S"
                          style={compactInput}
                        />
                        <input
                          type="number"
                          step="0.1"
                          value={frame.opacity}
                          onChange={(e) =>
                            patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                              prev.map((en) =>
                                en.id === frame.id
                                  ? { ...en, opacity: clamp(+e.target.value || 0, 0, 1) }
                                  : en
                              )
                            )
                          }
                          placeholder="O"
                          style={compactInput}
                        />
                        <button
                          onClick={() =>
                            patchTimelineKeyframes(activeTimelineItem.id, (prev) =>
                              isPinned || prev.length <= 2
                                ? prev
                                : prev.filter((en) => en.id !== frame.id)
                            )
                          }
                          style={{
                            border: 'none',
                            background: 'transparent',
                            color: isPinned ? '#1e2740' : '#f87171',
                            cursor: isPinned ? 'default' : 'pointer',
                            fontSize: 12,
                            lineHeight: 1,
                          }}
                        >
                          ×
                        </button>
                      </div>
                    );
                  })}
                </div>
                <div
                  style={{
                    display: 'grid',
                    gridTemplateColumns: '52px 1fr 1fr 1fr 1fr 22px',
                    gap: 3,
                    marginTop: 3,
                    fontSize: 8,
                    color: EDITOR_THEME.shellMutedSoft,
                  }}
                >
                  <span>sn</span>
                  <span>X</span>
                  <span>Y</span>
                  <span>Scale</span>
                  <span>Opacity</span>
                  <span />
                </div>
              </>
            ) : (
              <div style={{ fontSize: 9, color: EDITOR_THEME.shellMutedSoft }}>
                Keyframe yok. + Keyframe ile hareket noktası ekle.
              </div>
            )}
          </div>
        </div>
      )}

      {/* ── Track area ── */}
      <div style={{ flex: 1, overflowX: 'auto', overflowY: 'auto', padding: 0 }}>
        {timeline.length > 0 ? (
          <div style={{ minWidth: labelColumnWidth + trackWidth, padding: 10 }}>
            {/* Column headers */}
            <div
              style={{
                display: 'flex',
                minWidth: labelColumnWidth + trackWidth,
                position: 'sticky',
                top: 0,
                zIndex: 2,
                background: EDITOR_THEME.shellPanel,
                borderRadius: '12px 12px 0 0',
                overflow: 'hidden',
              }}
            >
              <div
                style={{
                  width: labelColumnWidth,
                  flexShrink: 0,
                  padding: '8px 12px',
                  fontSize: 9,
                  fontWeight: 800,
                  color: EDITOR_THEME.shellMutedSoft,
                  textTransform: 'uppercase',
                  letterSpacing: 0.7,
                  background: EDITOR_THEME.shellPanel,
                  borderRight: `1px solid ${EDITOR_THEME.shellBorder}`,
                  borderBottom: `1px solid ${EDITOR_THEME.shellBorder}`,
                }}
              >
                Nesneler
              </div>
              <div
                onPointerDown={scrubFromPointer}
                style={{
                  width: trackWidth,
                  height: 32,
                  position: 'relative',
                  cursor: 'ew-resize',
                  borderBottom: `1px solid ${EDITOR_THEME.shellBorder}`,
                  background: EDITOR_THEME.shellPanel,
                }}
              >
                {timelineTicks.map((tick) => (
                  <div
                    key={tick.second}
                    style={{
                      position: 'absolute',
                      left: tick.left,
                      top: 0,
                      bottom: 0,
                      width: 1,
                      background: tick.major
                        ? EDITOR_THEME.shellBorderStrong
                        : EDITOR_THEME.shellPanelAlt,
                    }}
                  >
                    {tick.major && (
                      <span
                        style={{
                          position: 'absolute',
                          top: 7,
                          left: 4,
                          fontSize: 9,
                          color: EDITOR_THEME.shellMutedSoft,
                        }}
                      >
                        {tick.second}s
                      </span>
                    )}
                  </div>
                ))}
                <div
                  style={{
                    position: 'absolute',
                    left: currentTime * pixelsPerSecond - 4,
                    top: 0,
                    width: 0,
                    height: 0,
                    borderLeft: '4px solid transparent',
                    borderRight: '4px solid transparent',
                    borderTop: '7px solid #ef4444',
                  }}
                />
                <div
                  style={{
                    position: 'absolute',
                    left: currentTime * pixelsPerSecond,
                    top: 0,
                    bottom: 0,
                    width: 1,
                    background: '#ef4444',
                  }}
                />
              </div>
            </div>

            {/* Rows */}
            {timeline.map((item, rowIndex) => {
              const object = objects.find((entry) => entry.id === item.objectId) || null;
              const label = object?.label || object?.type || item.name || 'Klip';
              const isSelected = activeTimelineItem?.id === item.id;
              const isActive = isObjectTimelineActive(activity, item.objectId, currentTime);
              const objectIcon =
                objectTypeIcons[object?.type || 'default'] || objectTypeIcons.default;
              const rowBg = isSelected
                ? 'rgba(56,189,248,.08)'
                : rowIndex % 2 === 0
                  ? 'rgba(9,18,33,.84)'
                  : 'rgba(11,20,36,.96)';
              return (
                <div
                  key={item.id}
                  style={{
                    display: 'flex',
                    alignItems: 'stretch',
                    minWidth: labelColumnWidth + trackWidth,
                  }}
                >
                  <button
                    onClick={() => onSelectObject(item.objectId)}
                    style={{
                      width: labelColumnWidth,
                      flexShrink: 0,
                      border: 'none',
                      borderRight: `1px solid ${EDITOR_THEME.shellBorder}`,
                      borderBottom: `1px solid ${EDITOR_THEME.shellBorder}`,
                      background: rowBg,
                      padding: '8px 10px',
                      cursor: 'pointer',
                      textAlign: 'left',
                      minHeight: rowHeight,
                    }}
                  >
                    <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                      <span
                        style={{
                          width: 20,
                          height: 20,
                          borderRadius: 5,
                          border: `1px solid ${isSelected ? EDITOR_THEME.shellAccentBorder : EDITOR_THEME.shellBorderSoft}`,
                          background: isSelected
                            ? EDITOR_THEME.shellAccentSoft
                            : 'rgba(255,255,255,.04)',
                          color: isSelected ? '#a5e6ff' : EDITOR_THEME.shellMutedSoft,
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontSize: 10,
                          fontWeight: 800,
                          flexShrink: 0,
                        }}
                      >
                        {objectIcon}
                      </span>
                      <span
                        style={{
                          width: 8,
                          height: 8,
                          borderRadius: 999,
                          background: isActive
                            ? EDITOR_THEME.shellSuccess
                            : isSelected
                              ? EDITOR_THEME.shellAccent
                              : EDITOR_THEME.shellPanelAlt,
                          boxShadow: isActive ? '0 0 0 3px rgba(74,222,128,.15)' : 'none',
                          flexShrink: 0,
                        }}
                      />
                      <div style={{ flex: 1, minWidth: 0 }}>
                        <div
                          style={{
                            fontSize: 10,
                            fontWeight: 700,
                            color: isSelected ? '#a5e6ff' : EDITOR_THEME.shellMuted,
                            whiteSpace: 'nowrap',
                            overflow: 'hidden',
                            textOverflow: 'ellipsis',
                          }}
                        >
                          {label}
                        </div>
                        <div
                          style={{ fontSize: 8, color: EDITOR_THEME.shellMutedSoft, marginTop: 2 }}
                        >
                          {Number(item.start || 0).toFixed(1)}s–
                          {Number((item.start || 0) + (item.duration || 0)).toFixed(1)}s ·{' '}
                          {item.entryEffect || 'fade'}
                        </div>
                      </div>
                    </div>
                  </button>

                  <div
                    onPointerDown={scrubFromPointer}
                    style={{
                      width: trackWidth,
                      height: rowHeight,
                      position: 'relative',
                      borderBottom: `1px solid ${EDITOR_THEME.shellBorder}`,
                      background: rowBg,
                      cursor: 'ew-resize',
                    }}
                  >
                    {timelineTicks.map((tick) => (
                      <div
                        key={tick.second}
                        style={{
                          position: 'absolute',
                          left: tick.left,
                          top: 0,
                          bottom: 0,
                          width: 1,
                          background: tick.major
                            ? EDITOR_THEME.shellPanelAlt
                            : EDITOR_THEME.shellBg,
                        }}
                      />
                    ))}
                    <div
                      style={{
                        position: 'absolute',
                        left: currentTime * pixelsPerSecond,
                        top: 0,
                        bottom: 0,
                        width: 1,
                        background: '#ef4444',
                        pointerEvents: 'none',
                      }}
                    />

                    <div
                      onClick={(e) => {
                        e.stopPropagation();
                        onSelectObject(item.objectId);
                      }}
                      onPointerDown={(e) => beginClipDrag(e, item, 'move')}
                      style={{
                        position: 'absolute',
                        left: item.start * pixelsPerSecond,
                        top: 10,
                        width: Math.max(24, item.duration * pixelsPerSecond),
                        height: 32,
                        borderRadius: 10,
                        background: isSelected
                          ? 'linear-gradient(180deg,rgba(14,165,233,.5),rgba(8,47,73,.86))'
                          : 'linear-gradient(180deg,rgba(56,189,248,.28),rgba(8,47,73,.84))',
                        border: `1px solid ${isSelected ? 'rgba(125,211,252,.9)' : 'rgba(56,189,248,.45)'}`,
                        color: isSelected ? '#e0f2fe' : '#bae6fd',
                        cursor: 'grab',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between',
                        padding: '0 8px',
                        overflow: 'hidden',
                        boxShadow: isSelected
                          ? '0 10px 22px rgba(14,165,233,.2)'
                          : '0 4px 12px rgba(2,8,23,.18)',
                      }}
                    >
                      <div
                        onPointerDown={(e) => beginClipDrag(e, item, 'resize-start')}
                        style={{
                          width: 6,
                          alignSelf: 'stretch',
                          cursor: 'ew-resize',
                          marginLeft: -2,
                        }}
                      />
                      <span
                        style={{
                          fontSize: 9,
                          fontWeight: 700,
                          whiteSpace: 'nowrap',
                          overflow: 'hidden',
                          textOverflow: 'ellipsis',
                        }}
                      >
                        {label}
                      </span>
                      <span style={{ fontSize: 8, opacity: 0.8, marginLeft: 6 }}>
                        {Number(item.duration || 0).toFixed(1)}s
                      </span>
                      <div
                        onPointerDown={(e) => beginClipDrag(e, item, 'resize-end')}
                        style={{
                          width: 6,
                          alignSelf: 'stretch',
                          cursor: 'ew-resize',
                          marginRight: -2,
                        }}
                      />
                    </div>

                    {(item.keyframes || []).map((frame, fi) => (
                      <div
                        key={frame.id}
                        style={{
                          position: 'absolute',
                          left: (item.start + frame.time) * pixelsPerSecond - 4,
                          top: rowHeight - 12,
                          width: 8,
                          height: 8,
                          borderRadius: 1,
                          transform: 'rotate(45deg)',
                          background:
                            fi === 0 || fi === (item.keyframes || []).length - 1
                              ? 'rgba(56,189,248,.55)'
                              : EDITOR_THEME.shellBorderStrong,
                          border: `1px solid ${isSelected ? EDITOR_THEME.shellAccent : EDITOR_THEME.shellBorder}`,
                        }}
                        title={`${frame.time}s`}
                      />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div
            style={{
              height: '100%',
              border: `1px dashed ${EDITOR_THEME.shellBorderSoft}`,
              borderRadius: 16,
              margin: 10,
              background: 'rgba(255,255,255,.03)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              color: EDITOR_THEME.shellMutedSoft,
              fontSize: 12,
              textAlign: 'center',
              padding: 16,
              lineHeight: 1.7,
            }}
          >
            Sahneye nesne ekleyin.
            <br />
            Timeline satırları ve klip kontrolleri otomatik oluşur.
          </div>
        )}
      </div>
    </div>
  );
}

function StoryboardPanel({ present, selActivityId, onSelect, onOpenContent }) {
  const currentBook = present.books.find((book) => book.id === present.selBookId) || null;
  const currentPublisher = present.publishers.find((pub) => pub.id === present.selPubId) || null;
  const activities = present.activities.filter((activity) => activity.bookId === present.selBookId);

  return (
    <div
      style={{
        width: 132,
        flexShrink: 0,
        border: '1px solid #252540',
        borderRadius: 14,
        background: '#0f1020',
        display: 'flex',
        flexDirection: 'column',
        overflow: 'hidden',
      }}
    >
      <div
        style={{ padding: '12px 10px', borderBottom: '1px solid #252540', background: '#131427' }}
      >
        <div
          style={{
            fontSize: 10,
            color: '#7b8ba1',
            textTransform: 'uppercase',
            letterSpacing: 0.8,
            marginBottom: 6,
          }}
        >
          Storyboard
        </div>
        <div style={{ fontSize: 12, fontWeight: 700, color: '#E0E0E0', lineHeight: 1.3 }}>
          {currentBook?.name || 'Kitap secilmedi'}
        </div>
        <div style={{ fontSize: 10, color: '#667085', marginTop: 4 }}>
          {currentPublisher?.name || 'Yayınevi seç'}
        </div>
        <button
          onClick={onOpenContent}
          style={{
            width: '100%',
            marginTop: 10,
            border: '1px solid #2a314b',
            background: '#171a31',
            color: '#9fb0d0',
            borderRadius: 8,
            padding: '6px 8px',
            cursor: 'pointer',
            fontSize: 10,
            fontWeight: 700,
          }}
        >
          İçerik Yönet
        </button>
      </div>
      <div
        style={{
          flex: 1,
          overflowY: 'auto',
          padding: 10,
          display: 'flex',
          flexDirection: 'column',
          gap: 10,
        }}
      >
        {activities.map((activity, index) => (
          <button
            key={activity.id}
            onClick={() => onSelect(activity.id)}
            style={{
              border: `1px solid ${selActivityId === activity.id ? '#4CAF50' : '#2a314b'}`,
              background: selActivityId === activity.id ? '#1a2a1a' : '#12162a',
              borderRadius: 10,
              padding: 6,
              cursor: 'pointer',
              textAlign: 'left',
            }}
          >
            <div
              style={{
                height: 62,
                borderRadius: 6,
                border: `1px solid ${selActivityId === activity.id ? '#4CAF50' : '#394150'}`,
                background: 'linear-gradient(180deg,#f8fafc,#dbe4f0)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                color: '#1f2937',
                fontSize: 10,
                fontWeight: 700,
              }}
            >
              Sahne {index + 1}
            </div>
            <div
              style={{
                fontSize: 10,
                color: selActivityId === activity.id ? '#A5D6A7' : '#B0BEC5',
                marginTop: 6,
                textAlign: 'center',
                whiteSpace: 'nowrap',
                overflow: 'hidden',
                textOverflow: 'ellipsis',
              }}
            >
              {activity.name || `Slider ${index + 1}`}
            </div>
          </button>
        ))}
        {activities.length === 0 && (
          <div
            style={{
              border: '1px dashed #2a314b',
