    );
  }

  return (
    <div
      style={{
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fill,minmax(180px,1fr))',
        gap: 16,
      }}
    >
      {items.map((item, index) => {
        const gradients = [
          ['#22c55e', '#06b6d4'],
          ['#f59e0b', '#ef4444'],
          ['#8b5cf6', '#ec4899'],
          ['#0ea5e9', '#6366f1'],
          ['#14b8a6', '#84cc16'],
