                <button
                  onClick={() => moveLayer(layer.id, 1)}
                  disabled={layers.findIndex((item) => item.id === layer.id) === layers.length - 1}
                  style={{
                    flex: 1,
                    minHeight: 28,
                    borderRadius: 8,
                    border: '1px solid #cbd5e1',
                    background: '#ffffff',
                    color: '#334155',
                    fontSize: 10,
                    fontWeight: 800,
                    cursor: 'pointer',
                    opacity:
                      layers.findIndex((item) => item.id === layer.id) === layers.length - 1
