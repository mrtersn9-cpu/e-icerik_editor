const StageCanvas = forwardRef(function StageCanvas(
  {
    activity,
    onUpdate,
    zoom = 'fit',
    onZoomChange,
    selectedIds,
    onSelectionChange,
    timelineTime = 0,
    answerPreview = null,
  },
  ref
) {
  const viewportRef = useRef(null);
  const stageRef = useRef(null);
  const latestRef = useRef(activity);
  const interactRef = useRef(null);
  const fileRef = useRef(null);
  const imgRef = useRef(null);
  const videoRef = useRef(null);
  const audioRef = useRef(null);
  const zoomRef = useRef(zoom);
  const latestSelectedIdsRef = useRef(selectedIds);
  const clipboardRef = useRef(null);
  const rubberStartRef = useRef(null);
  const rubberHandlersRef = useRef(null);
  const dragSnapshotRef = useRef(null);
  const [rubberBand, setRubberBand] = useState(null);
  const [viewportSize, setViewportSize] = useState({ width: 1280, height: 760 });

  useEffect(() => {
    latestRef.current = activity;
  }, [activity]);
  useEffect(() => {
    zoomRef.current = zoom;
  }, [zoom]);
  useEffect(() => {
    latestSelectedIdsRef.current = selectedIds;
  }, [selectedIds]);
  useEffect(
    () => () => {
      if (interactRef.current) {
        interactRef.current();
        interactRef.current = null;
      }
    },
    []
  );
  // Cleanup rubber-band listeners on unmount
  useEffect(() => {
    return () => {
      if (rubberHandlersRef.current) {
        window.removeEventListener('pointermove', rubberHandlersRef.current.move);
        window.removeEventListener('pointerup', rubberHandlersRef.current.up);
        rubberHandlersRef.current = null;
      }
    };
  }, []);
  useEffect(() => {
    const node = viewportRef.current;
    if (!node) return undefined;

    const updateViewport = () => {
      const rect = node.getBoundingClientRect();
      setViewportSize({
        width: Math.max(260, rect.width),
        height: Math.max(240, rect.height),
      });
    };

    updateViewport();
    if (typeof ResizeObserver === 'undefined') {
      window.addEventListener('resize', updateViewport);
      return () => window.removeEventListener('resize', updateViewport);
    }

    const observer = new ResizeObserver(updateViewport);
    observer.observe(node);
    return () => observer.disconnect();
  }, []);

  const objects = getCanvasObjects(activity);
  const timeline = getActivityTimeline(activity);
  const hasSvg = !!activity.svgMarkup;
  const hasObjects = objects.length > 0;
  const pdfBackgroundObject = useMemo(
    () => objects.find((object) => object?.isPdfBackground && object?.imageData) || null,
    [objects]
  );
  const renderObjects = useMemo(
    () => objects.filter((object) => !pdfBackgroundObject || object.id !== pdfBackgroundObject.id),
    [objects, pdfBackgroundObject]
  );

  const baseScale = useMemo(() => {
    return getFitScale(
      activity.stageWidth || 1920,
      activity.stageHeight || 1080,
      viewportSize.width - 20,
      viewportSize.height - 52
    );
  }, [activity.stageWidth, activity.stageHeight, viewportSize.height, viewportSize.width]);

  useEffect(() => {
    const node = viewportRef.current;
    if (!node || !onZoomChange) return undefined;

    const onNativeWheel = (event) => {
      if (!(event.ctrlKey || event.metaKey)) return;
      event.preventDefault();
      event.stopPropagation();
      const delta = event.deltaY < 0 ? 0.1 : -0.1;
      onZoomChange((current) => {
        const currentScale = current === 'fit' ? baseScale : Number(current) || baseScale;
        return clamp(Number((currentScale + delta).toFixed(2)), 0.1, 4);
      });
    };

    node.addEventListener('wheel', onNativeWheel, { passive: false });
    return () => node.removeEventListener('wheel', onNativeWheel, { passive: false });
  }, [baseScale, onZoomChange]);

  const resolvedZoom = zoom === 'fit' ? baseScale : Number(zoom) || baseScale;
  const scale = resolvedZoom;
  const vw = Math.round((activity.stageWidth || 1920) * scale);
  const vh = Math.round((activity.stageHeight || 1080) * scale);
  const zoomPercent = Math.round(scale * 100);

  const toStage = useCallback(
    (cx, cy) => {
      const r = stageRef.current?.getBoundingClientRect();
      if (!r) return { x: 0, y: 0 };
      const sw = latestRef.current.stageWidth || 1920;
      const sh = latestRef.current.stageHeight || 1080;
      const sc = zoomRef.current === 'fit' ? baseScale : Number(zoomRef.current) || baseScale;
      return {
        x: Math.min(Math.max((cx - r.left) / sc, 0), sw),
        y: Math.min(Math.max((cy - r.top) / sc, 0), sh),
      };
    },
    [baseScale]
  );

  const patchAct = useCallback(
    (p) => {
      const a = latestRef.current;
      onUpdate({ ...a, ...p });
    },
    [onUpdate]
  );

  const patchObj = useCallback(
    (id, p, options = {}) => {
      const a = latestRef.current;
      onUpdate(updateActivityObject(a, id, p, options));
    },
    [onUpdate]
  );

  const addObject = useCallback(
    (type) => {
      const a = latestRef.current;
      const objs = a.objects || [];
      const o = createObjectFromActivity(a, type);
      o.zIndex = objs.length + 1;
      o.layerId = a.activeLayerId || 'base';
      // draggable/dropzone presets already have correct default colors — no override needed
      onUpdate({
        ...a,
        objects: [...objs, o],
        selectedObjectId: o.id,
        timeline: syncTimelineWithObjects({ ...a, objects: [...objs, o] }),
      });
      onSelectionChange(new Set([o.id]));
    },
    [onUpdate, onSelectionChange]
  );

  const addImageFile = useCallback(
    (file) => {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const a = latestRef.current;
        const objs = a.objects || [];
        const o = createObject('image');
        o.imageData = ev.target.result;
        o.label = file.name.replace(/\.[^.]+$/, '');
        o.zIndex = objs.length + 1;
        o.layerId = a.activeLayerId || 'base';
        onUpdate({
          ...a,
          objects: [...objs, o],
          selectedObjectId: o.id,
          timeline: syncTimelineWithObjects({ ...a, objects: [...objs, o] }),
        });
        onSelectionChange(new Set([o.id]));
      };
      reader.readAsDataURL(file);
    },
    [onUpdate, onSelectionChange]
  );

  const addVideoFile = useCallback(
    async (file) => {
      if (!file) return;
      const mediaUrl = await uploadMediaFile(file);
      const a = latestRef.current;
      const objs = a.objects || [];
      const o = createObject('video');
      o.mediaUrl = mediaUrl;
      o.mediaName = file.name;
      o.label = file.name.replace(/\.[^.]+$/, '') || 'Video';
      o.zIndex = objs.length + 1;
      o.layerId = a.activeLayerId || 'base';
      onUpdate({
        ...a,
        objects: [...objs, o],
        selectedObjectId: o.id,
        timeline: syncTimelineWithObjects({ ...a, objects: [...objs, o] }),
      });
      onSelectionChange(new Set([o.id]));
    },
    [onUpdate, onSelectionChange]
  );

  const addAudioFile = useCallback(
    async (file) => {
      if (!file) return;
      const mediaUrl = await uploadMediaFile(file);
      const a = latestRef.current;
      const objs = a.objects || [];
      const o = createObject('audio');
      o.mediaUrl = mediaUrl;
      o.mediaName = file.name;
      o.label = file.name.replace(/\.[^.]+$/, '') || 'Ses';
      o.zIndex = objs.length + 1;
      o.layerId = a.activeLayerId || 'base';
      onUpdate({
        ...a,
        objects: [...objs, o],
        selectedObjectId: o.id,
        timeline: syncTimelineWithObjects({ ...a, objects: [...objs, o] }),
      });
      onSelectionChange(new Set([o.id]));
    },
    [onUpdate, onSelectionChange]
  );

  const loadSvgFile = useCallback(
    (file) => {
      if (!file) return;
      file.text().then((markup) => patchAct({ svgMarkup: markup, svgName: file.name }));
    },
    [patchAct]
  );

  const deleteSelected = useCallback(() => {
    const a = latestRef.current;
    const ids = latestSelectedIdsRef.current;
    const toDelete =
      ids.size > 0 ? ids : a.selectedObjectId ? new Set([a.selectedObjectId]) : new Set();
    if (toDelete.size === 0) return;
    const rest = (a.objects || []).filter((o) => !toDelete.has(o.id));
    onUpdate({
      ...a,
      objects: rest,
      selectedObjectId: rest[rest.length - 1]?.id || null,
      timeline: syncTimelineWithObjects({ ...a, objects: rest }),
    });
    onSelectionChange(new Set());
  }, [onUpdate, onSelectionChange]);

  const copySelected = useCallback(() => {
    const a = latestRef.current;
    const ids =
      latestSelectedIdsRef.current.size > 0
        ? latestSelectedIdsRef.current
        : a.selectedObjectId
          ? new Set([a.selectedObjectId])
          : new Set();
    if (ids.size === 0) return false;

    const selectedObjects = (a.objects || [])
      .filter((item) => ids.has(item.id))
      .sort((left, right) => (left.zIndex || 0) - (right.zIndex || 0));
    if (!selectedObjects.length) return false;

    const timelineByObject = new Map(getActivityTimeline(a).map((item) => [item.objectId, item]));
    clipboardRef.current = {
      objects: selectedObjects.map((item) => ({
        ...item,
        style: item.style ? { ...item.style } : item.style,
      })),
      timeline: selectedObjects
        .map((item) => timelineByObject.get(item.id))
        .filter(Boolean)
        .map((item) => ({
          ...item,
          keyframes: Array.isArray(item.keyframes)
            ? item.keyframes.map((frame) => ({ ...frame }))
            : [],
        })),
      copiedAt: Date.now(),
    };
    return true;
  }, []);

  const pasteClipboard = useCallback(() => {
    const clipboard = clipboardRef.current;
    if (!clipboard?.objects?.length) return false;

    const a = latestRef.current;
    const existingObjects = a.objects || [];
    const existingTimeline = getActivityTimeline(a);
    const idMap = new Map();
    const newSelection = new Set();
    const duplicatedObjects = clipboard.objects.map((item, index) => {
      const newId = uid();
      idMap.set(item.id, newId);
      newSelection.add(newId);
      return {
        ...item,
        id: newId,
        x: Math.max(0, (Number(item.x) || 0) + 24),
        y: Math.max(0, (Number(item.y) || 0) + 24),
        zIndex: existingObjects.length + index + 1,
        style: item.style ? { ...item.style } : item.style,
      };
    });
    const duplicatedTimeline = (clipboard.timeline || []).map((item, index) => ({
      ...item,
      id: uid(),
      objectId: idMap.get(item.objectId) || '',
      track: existingTimeline.length + index,
      keyframes: Array.isArray(item.keyframes)
        ? item.keyframes.map((frame) => ({ ...frame, id: uid() }))
        : [],
    }));
    const nextObjects = [...existingObjects, ...duplicatedObjects];
    const nextTimeline = syncTimelineWithObjects({
      ...a,
      objects: nextObjects,
      timeline: [...existingTimeline, ...duplicatedTimeline],
    });
    const lastId = duplicatedObjects[duplicatedObjects.length - 1]?.id || null;
    onUpdate({ ...a, objects: nextObjects, selectedObjectId: lastId, timeline: nextTimeline });
    onSelectionChange(newSelection);
    return true;
  }, [onSelectionChange, onUpdate]);

  const duplicateSelected = useCallback(() => {
    if (!copySelected()) return;
    pasteClipboard();
  }, [copySelected, pasteClipboard]);

  const bringFront = useCallback(() => {
    const a = latestRef.current;
    const id = a.selectedObjectId;
    if (!id) return;
    onUpdate({
      ...a,
      objects: (a.objects || []).map((o) =>
        o.id === id ? { ...o, zIndex: (a.objects || []).length + 1 } : o
      ),
    });
  }, [onUpdate]);

  const sendBack = useCallback(() => {
    const a = latestRef.current;
    const id = a.selectedObjectId;
    if (!id) return;
    onUpdate({
      ...a,
      objects: (a.objects || []).map((o) =>
        o.id === id ? { ...o, zIndex: 1 } : { ...o, zIndex: o.zIndex + 1 }
      ),
    });
  }, [onUpdate]);

  const nudge = useCallback(
    (dx, dy) => {
      const a = latestRef.current;
      const ids = latestSelectedIdsRef.current;
      const targetIds =
        ids.size > 0 ? ids : a.selectedObjectId ? new Set([a.selectedObjectId]) : new Set();
      if (targetIds.size === 0) return;
      onUpdate({
        ...a,
        objects: (a.objects || []).map((o) =>
          targetIds.has(o.id) ? { ...o, x: o.x + dx, y: o.y + dy } : o
        ),
      });
    },
    [onUpdate]
  );

  useImperativeHandle(
    ref,
    () => ({
      addObject,
      addImage: () => imgRef.current?.click(),
      addVideo: () => videoRef.current?.click(),
      addAudio: () => audioRef.current?.click(),
      loadSVG: () => fileRef.current?.click(),
      deleteSelected,
      copySelected,
      pasteClipboard,
      duplicateSelected,
      bringFront,
      sendBack,
      nudge,
    }),
    [
      addObject,
      deleteSelected,
      copySelected,
      pasteClipboard,
      duplicateSelected,
      bringFront,
      sendBack,
      nudge,
    ]
  );

  const startInteract = (e, objId, mode, handle = '') => {
    e.preventDefault();
    e.stopPropagation();
    e.currentTarget?.setPointerCapture?.(e.pointerId);
    const a = latestRef.current;
    const obj = (a.objects || []).find((o) => o.id === objId);
    if (!obj || obj.locked || obj.visible === false) return;

    // Update selection
    const currentIds = latestSelectedIdsRef.current;
    const wasAlreadySelected = currentIds.has(objId);
    let newIds;
    if (e.shiftKey) {
      newIds = new Set(currentIds);
      // Toggle: remove if already selected, add if not
      if (newIds.has(objId)) newIds.delete(objId);
      else newIds.add(objId);
    } else {
      // Keep existing multi-selection if clicking an already-selected object (supports group drag)
      // Will be reduced to single on pointerup if no drag movement occurred
      newIds = wasAlreadySelected && currentIds.size > 1 ? currentIds : new Set([objId]);
    }
    onSelectionChange(newIds);
    // selectedObjectId: the primary object for inspector (must be in selection)
    onUpdate({ ...a, selectedObjectId: newIds.has(objId) ? objId : [...newIds][0] || null });

    const origin = toStage(e.clientX, e.clientY);
    let hasMoved = false;
    const isShift = e.shiftKey;
    // Flag: we deferred single-selection reduce until pointerup (no drag)
    const deferredSingleSelect = !isShift && wasAlreadySelected && currentIds.size > 1;

    // Snapshot selected objects' initial positions for drag
    const snapIds = newIds.has(objId) ? newIds : new Set([objId]);
    dragSnapshotRef.current = Object.fromEntries(
      (a.objects || [])
        .filter((o) => snapIds.has(o.id))
        .map((o) => [o.id, { x: o.x, y: o.y, width: o.width, height: o.height }])
    );

    const onMove = (me) => {
      const pt = toStage(me.clientX, me.clientY);
      const dx = pt.x - origin.x,
        dy = pt.y - origin.y;
      if (Math.abs(dx) > 2 || Math.abs(dy) > 2) hasMoved = true;
      const curr = latestRef.current;
      const sw = curr.stageWidth || 1920,
        sh = curr.stageHeight || 1080;
      const MIN = 30;

      if (mode === 'move') {
        const snap = dragSnapshotRef.current || {};
        const updatedObjects = (curr.objects || []).map((o) => {
          if (!snap[o.id]) return o;
          const s = snap[o.id];
          return {
            ...o,
            x: Math.min(Math.max(s.x + dx, 0), Math.max(0, sw - o.width)),
            y: Math.min(Math.max(s.y + dy, 0), Math.max(0, sh - o.height)),
          };
        });
        onUpdate({ ...curr, objects: updatedObjects });
      } else {
        const s = dragSnapshotRef.current?.[objId] || obj;
        const r = s.x + s.width,
          b = s.y + s.height;
        let next = { x: s.x, y: s.y, width: s.width, height: s.height };
        if (handle.includes('e')) next.width = Math.max(MIN, s.width + dx);
        if (handle.includes('s')) next.height = Math.max(MIN, s.height + dy);
        if (handle.includes('w')) {
          next.x = Math.max(0, Math.min(s.x + dx, r - MIN));
          next.width = Math.max(MIN, r - next.x);
        }
        if (handle.includes('n')) {
          next.y = Math.max(0, Math.min(s.y + dy, b - MIN));
          next.height = Math.max(MIN, b - next.y);
        }
        patchObj(objId, next);
      }
    };

    const onUp = () => {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      interactRef.current = null;
      dragSnapshotRef.current = null;
      // Plain click (no drag) on a multi-selected object → reduce to single selection
      if (!hasMoved && deferredSingleSelect) {
        const singleSet = new Set([objId]);
        onSelectionChange(singleSet);
        onUpdate({ ...latestRef.current, selectedObjectId: objId });
      }
    };
    interactRef.current = onUp;
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
  };

  // Rubber-band selection
  const startRubber = (e) => {
    if (e.target !== stageRef.current) return;
    e.preventDefault();
    e.currentTarget?.setPointerCapture?.(e.pointerId);
    const r = stageRef.current.getBoundingClientRect();
    const x0 = e.clientX - r.left,
      y0 = e.clientY - r.top;
    const isShift = e.shiftKey;
    // Snapshot pre-existing selection for shift+rubber-band additive mode
    const prevIds = new Set(latestSelectedIdsRef.current);
    rubberStartRef.current = { x0, y0, r };

    if (!isShift) {
      onSelectionChange(new Set());
      patchAct({ selectedObjectId: null });
    }

    const onMove = (me) => {
      if (!rubberStartRef.current) return;
      const x1 = me.clientX - rubberStartRef.current.r.left;
      const y1 = me.clientY - rubberStartRef.current.r.top;
      setRubberBand({ x0: rubberStartRef.current.x0, y0: rubberStartRef.current.y0, x1, y1 });
    };
    const onUp = (me) => {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      rubberHandlersRef.current = null;
      if (!rubberStartRef.current) return;
      const rc = rubberStartRef.current.r;
      const sc = zoomRef.current === 'fit' ? baseScale : Number(zoomRef.current) || baseScale;
      const rx0 = rubberStartRef.current.x0 / sc,
        ry0 = rubberStartRef.current.y0 / sc;
      const rx1 = (me.clientX - rc.left) / sc,
        ry1 = (me.clientY - rc.top) / sc;
      const minX = Math.min(rx0, rx1),
        maxX = Math.max(rx0, rx1);
      const minY = Math.min(ry0, ry1),
        maxY = Math.max(ry0, ry1);
      const dist = Math.sqrt(
        Math.pow(me.clientX - rc.left - rubberStartRef.current.x0, 2) +
          Math.pow(me.clientY - rc.top - rubberStartRef.current.y0, 2)
      );
      if (dist > 5) {
        const bandHits = new Set(
          getCanvasObjects(latestRef.current)
            .filter(
              (o) =>
                o.visible !== false &&
                !o.locked &&
                o.x < maxX &&
                o.x + o.width > minX &&
                o.y < maxY &&
                o.y + o.height > minY
            )
            .map((o) => o.id)
        );
        // Shift: merge with previous; normal: replace
        const selected = isShift ? new Set([...prevIds, ...bandHits]) : bandHits;
        onSelectionChange(selected);
        if (selected.size === 1)
          onUpdate({ ...latestRef.current, selectedObjectId: [...selected][0] });
        else if (selected.size > 1) onUpdate({ ...latestRef.current, selectedObjectId: null });
      }
      rubberStartRef.current = null;
      setRubberBand(null);
    };
    rubberHandlersRef.current = { move: onMove, up: onUp };
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
  };

  const addImage = (e) => {
    addImageFile(e.target.files[0]);
    e.target.value = '';
  };
  const addVideo = (e) => {
    addVideoFile(e.target.files[0]);
    e.target.value = '';
  };
  const addAudio = (e) => {
    addAudioFile(e.target.files[0]);
    e.target.value = '';
  };
  const loadSVG = (e) => {
    loadSvgFile(e.target.files[0]);
    e.target.value = '';
  };
  const zoomStep = useCallback(
    (delta) => {
      if (!onZoomChange) return;
      onZoomChange((current) => {
        const currentScale = current === 'fit' ? baseScale : Number(current) || baseScale;
        return clamp(Number((currentScale + delta).toFixed(2)), 0.1, 4);
      });
    },
    [onZoomChange]
  );
  const fitZoom = useCallback(() => {
    if (!onZoomChange) return;
    onZoomChange('fit');
  }, [onZoomChange]);
  const actualZoom = useCallback(() => {
    if (!onZoomChange) return;
    onZoomChange(1);
  }, [onZoomChange]);
  return (
    <div
      ref={viewportRef}
      data-stage-zoom-scope="true"
      style={{
        flex: 1,
        overflow: 'auto',
        background: '#ffffff',
        display: 'flex',
        alignItems: 'flex-start',
        justifyContent: 'center',
        padding: 10,
      }}
    >
      <div style={{ position: 'relative' }}>
        <div
          style={{
            position: 'sticky',
            top: 12,
            zIndex: 20,
            display: 'flex',
            justifyContent: 'flex-end',
            pointerEvents: 'none',
            marginBottom: 10,
          }}
        >
          <div
            style={{
              pointerEvents: 'auto',
              display: 'flex',
              alignItems: 'center',
              gap: 6,
              padding: '8px 10px',
              borderRadius: 0,
              border: '1px solid #111111',
              background: '#ffffff',
              boxShadow: 'none',
            }}
          >
            <button
              onClick={() => zoomStep(-0.1)}
              style={{
                width: 28,
                height: 28,
                borderRadius: '50%',
                border: '1px solid #334155',
                background: '#162036',
                color: '#dbeafe',
                cursor: 'pointer',
                fontSize: 16,
                lineHeight: 1,
              }}
            >
              -
            </button>
            <button
              onClick={fitZoom}
              style={{
                border: '1px solid #111111',
                background: '#ffffff',
                color: '#111111',
                borderRadius: 0,
                padding: '6px 10px',
                cursor: 'pointer',
                fontSize: 11,
                fontWeight: 700,
                minWidth: 64,
              }}
            >
              {zoomPercent}%
            </button>
            <button
              onClick={() => zoomStep(0.1)}
              style={{
                width: 28,
                height: 28,
                borderRadius: 0,
                border: '1px solid #111111',
                background: '#ffffff',
                color: '#111111',
                cursor: 'pointer',
                fontSize: 16,
                lineHeight: 1,
              }}
            >
              +
            </button>
            <button
              onClick={fitZoom}
              style={{
                border: '1px solid #111111',
                background: '#ffffff',
                color: '#111111',
                borderRadius: 0,
                padding: '6px 10px',
                cursor: 'pointer',
                fontSize: 10,
                fontWeight: 700,
              }}
            >
              Sığdır
            </button>
            <button
              onClick={actualZoom}
              style={{
                border: '1px solid #111111',
                background: '#ffffff',
                color: '#111111',
                borderRadius: 0,
                padding: '6px 10px',
                cursor: 'pointer',
                fontSize: 10,
                fontWeight: 700,
              }}
            >
              1:1
            </button>
          </div>
        </div>
        <div
          style={{
            fontSize: 9,
            color: '#444444',
            marginBottom: 8,
            display: 'flex',
            justifyContent: 'space-between',
            gap: 10,
          }}
        >
          <span>
            {activity.stageWidth} x {activity.stageHeight} | x{scale.toFixed(2)} |{' '}
            {activity.activeLayerId === 'base' ? 'Ana Katman' : 'Katman + Ana Katman'}
          </span>
          <span>
            {selectedIds.size > 0
              ? `${selectedIds.size} secili`
              : `${objects.length} gorunen nesne`}{' '}
            | Ctrl + tekerlek sahneyi zoomlar
          </span>
        </div>
        <div
          style={{
            marginBottom: 12,
            padding: '12px 14px',
            borderRadius: 0,
            border: '1px solid #111111',
            background: '#ffffff',
            color: '#333333',
            fontSize: 11,
            lineHeight: 1.6,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: 12,
            flexWrap: 'wrap',
            boxShadow: 'none',
          }}
        >
          <span>
            {hasSvg
              ? "1. Zeminin uzerine nesne ekle. 2. Nesneyi sec. 3. Timeline'dan sure ve animasyon ver. 4. Onizle ile test et."
              : '1. Once SVG zemin yukle. 2. Uzerine nesne ekle. 3. Timeline ve tetikleyici ile hareket ver.'}
          </span>
          <span style={{ color: '#111111', fontWeight: 800 }}>
            {hasSvg
              ? selectedIds.size > 0
                ? "Secili nesne timeline'da da vurgulanir."
                : 'Zemin hazir, nesne ekleyerek devam et.'
              : 'Bu editorde once SVG zemin yuklemen onerilir.'}
          </span>
        </div>
        <div style={{ fontSize: 9, color: '#444', marginBottom: 4, textAlign: 'right' }}>
          {activity.stageWidth}x{activity.stageHeight} | x{scale.toFixed(2)} |{' '}
          {selectedIds.size > 0 ? `${selectedIds.size} secili` : `${objects.length} nesne`}
        </div>
        <div
          ref={stageRef}
          onPointerDown={startRubber}
          style={{
            width: vw,
            height: vh,
            position: 'relative',
            background: activity.backgroundColor || '#fff',
            border: '1px solid #111111',
            borderRadius: 0,
            overflow: 'hidden',
            cursor: 'crosshair',
            boxShadow: 'none',
            touchAction: 'none',
          }}
        >
          {pdfBackgroundObject && (
            <img
              src={pdfBackgroundObject.imageData}
              alt={pdfBackgroundObject.label || 'PDF Zemin'}
              style={{
                position: 'absolute',
                inset: 0,
                width: '100%',
                height: '100%',
                objectFit: 'contain',
                pointerEvents: 'none',
                userSelect: 'none',
                zIndex: 0,
              }}
            />
          )}
          {/* Izgara */}
          <div
            style={{
              position: 'absolute',
              inset: 0,
              backgroundImage:
                'linear-gradient(rgba(0,0,0,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,0,.04) 1px,transparent 1px)',
              backgroundSize: `${40 * scale}px ${40 * scale}px`,
              pointerEvents: 'none',
            }}
          />
          {/* SVG zemin */}
          {activity.svgMarkup && (
            <div
              style={{ position: 'absolute', inset: 0, pointerEvents: 'none' }}
              dangerouslySetInnerHTML={{ __html: activity.svgMarkup }}
            />
          )}
          {!hasSvg && !hasObjects && (
            <div
              style={{
                position: 'absolute',
                inset: 0,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                padding: 24,
                zIndex: 2,
                background: 'rgba(255,255,255,.92)',
              }}
            >
              <div
                style={{
                  width: Math.min(vw - 40, 520),
                  maxWidth: '100%',
                  borderRadius: 0,
                  border: '1px solid #111111',
                  background: '#ffffff',
                  boxShadow: 'none',
                  padding: 24,
                  textAlign: 'center',
                }}
              >
                <div
                  style={{
                    fontSize: 12,
                    fontWeight: 800,
                    color: '#111111',
                    letterSpacing: 0.4,
                    textTransform: 'uppercase',
                    marginBottom: 10,
                  }}
                >
                  SVG-first baslangic
                </div>
                <div
                  style={{
                    fontSize: 24,
                    fontWeight: 800,
                    color: '#111111',
                    lineHeight: 1.2,
                    marginBottom: 10,
                  }}
                >
                  Once SVG zemin yukle
                </div>
                <div style={{ fontSize: 13, color: '#333333', lineHeight: 1.7, marginBottom: 18 }}>
                  Bu editorde en rahat akis, once zemini yukleyip sonra buton, hotspot, video ve
                  metinleri onun ustune yerlestirmektir.
                </div>
                <div
                  style={{
                    display: 'grid',
                    gridTemplateColumns: 'repeat(3,minmax(0,1fr))',
                    gap: 8,
                    marginBottom: 18,
                    textAlign: 'left',
                  }}
                >
                  <div
                    style={{
                      borderRadius: 0,
                      background: '#ffffff',
                      border: '1px solid #111111',
                      padding: 10,
                      fontSize: 11,
                      color: '#111111',
                    }}
                  >
                    <strong>1.</strong> SVG zemin yukle
                  </div>
                  <div
                    style={{
                      borderRadius: 0,
                      background: '#ffffff',
                      border: '1px solid #111111',
                      padding: 10,
                      fontSize: 11,
                      color: '#111111',
                    }}
                  >
                    <strong>2.</strong> Nesneleri yerlestir
                  </div>
                  <div
                    style={{
                      borderRadius: 0,
                      background: '#ffffff',
                      border: '1px solid #111111',
                      padding: 10,
                      fontSize: 11,
                      color: '#111111',
                    }}
                  >
                    <strong>3.</strong> Timeline ve trigger ver
                  </div>
                </div>
                <div
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    gap: 10,
                    flexWrap: 'wrap',
                  }}
                >
                  <button
                    onClick={() => fileRef.current?.click()}
                    style={{
                      border: '1px solid #111111',
                      background: '#111111',
                      color: '#ffffff',
                      borderRadius: 0,
                      padding: '10px 18px',
                      cursor: 'pointer',
                      fontSize: 12,
                      fontWeight: 800,
                      boxShadow: 'none',
                    }}
                  >
                    SVG Zemin Yükle
                  </button>
                  <button
                    onClick={() => imgRef.current?.click()}
                    style={{
                      border: '1px solid #111111',
                      background: '#ffffff',
                      color: '#111111',
                      borderRadius: 0,
                      padding: '10px 16px',
                      cursor: 'pointer',
                      fontSize: 12,
                      fontWeight: 700,
                    }}
                  >
                    Resim ile basla
                  </button>
                </div>
                {!hasObjects && (
                  <div style={{ marginTop: 12, fontSize: 11, color: '#444444' }}>
                    SVG olmadan da devam edebilirsin ama sistemin ana akisi zemin ustunden ilerler.
                  </div>
                )}
              </div>
            </div>
          )}
          {/* Rubber-band seçim dikdörtgeni */}
          {rubberBand &&
            (() => {
              const { x0, y0, x1, y1 } = rubberBand;
              return (
                <div
                  style={{
                    position: 'absolute',
                    left: Math.min(x0, x1),
                    top: Math.min(y0, y1),
                    width: Math.abs(x1 - x0),
                    height: Math.abs(y1 - y0),
                    border: '1px dashed #111111',
                    background: 'rgba(17,17,17,.08)',
                    pointerEvents: 'none',
                    zIndex: 9999,
                  }}
                />
              );
            })()}
          {/* Nesneler */}
          {[...renderObjects]
            .filter((o) => o.visible !== false)
            .sort((a, b) => a.zIndex - b.zIndex)
            .map((o) => {
              const isSel = selectedIds.has(o.id) || activity.selectedObjectId === o.id;
              const isAnswerDragPreview = answerPreview?.dragId === o.id;
              const isAnswerDropPreview = answerPreview?.dropId === o.id;
              const isAnswerPreview = isAnswerDragPreview || isAnswerDropPreview;
              const st =
                o.type === 'draggable' || o.type === 'dropzone'
                  ? upgradeDragDropStyle(o.type, o.style || {})
                  : o.style || {};
              const isTimelineActive = isObjectTimelineActive(activity, o.id, timelineTime);
              const motionStyle = getTimelineMotionStyle(activity, o.id, timelineTime, {
                suppressBoundaryEffects: timelineTime <= 0.01,
              });
              const inactiveOpacity = o.type === 'draggable' || o.type === 'dropzone' ? 0.72 : 0.18;
              return (
                <div
                  key={o.id}
                  onPointerDown={(e) => startInteract(e, o.id, 'move')}
                  style={{
                    position: 'absolute',
                    left: o.x * scale,
                    top: o.y * scale,
                    width: o.width * scale,
                    height: o.height * scale,
                    transform: `translate(${motionStyle.translateX * scale}px, ${motionStyle.translateY * scale}px) rotate(${o.rotation || 0}deg) scale(${motionStyle.scale})`,
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    cursor: o.locked ? 'not-allowed' : 'move',
                    userSelect: 'none',
                    zIndex: o.zIndex,
                    background: o.imageData ? 'transparent' : st.background || 'transparent',
                    border: `${isSel || isAnswerPreview ? 2 : 1}px ${st.borderStyle || 'solid'} ${isSel ? '#111111' : isAnswerDragPreview ? '#2563eb' : isAnswerDropPreview ? '#ea580c' : st.borderColor || 'transparent'}`,
                    borderRadius: (st.borderRadius || 0) * scale,
                    outline: isSel
                      ? '2px solid rgba(17,17,17,.18)'
                      : isAnswerPreview
                        ? `3px solid ${isAnswerDragPreview ? 'rgba(37,99,235,.22)' : 'rgba(234,88,12,.22)'}`
                        : 'none',
                    boxSizing: 'border-box',
                    fontSize: (st.fontSize || 13) * scale,
                    color: st.color || '#111',
                    fontWeight: 600,
                    overflow: 'hidden',
                    opacity: isTimelineActive ? motionStyle.opacity : inactiveOpacity,
                    filter: isTimelineActive
                      ? 'none'
                      : o.type === 'draggable' || o.type === 'dropzone'
                        ? 'none'
                        : 'grayscale(.5)',
                    touchAction: 'none',
                    boxShadow: isAnswerPreview
                      ? `0 0 0 4px ${isAnswerDragPreview ? 'rgba(37,99,235,.14)' : 'rgba(234,88,12,.16)'}, 0 16px 28px rgba(15,23,42,.14)`
                      : 'none',
                  }}
                >
                  {o.selectionQuestionId ? (
                    <span
                      style={{
                        pointerEvents: 'none',
                        fontWeight: 900,
                        fontSize: Math.max(18, (st.fontSize || 13) * scale),
                        color: 'rgba(37,99,235,.18)',
                      }}
                    >
                      {' '}
                    </span>
                  ) : o.type === 'video' && o.mediaUrl ? (
                    <video
                      src={o.mediaUrl}
                      muted
                      loop={!!o.loop}
                      autoPlay={!!o.autoPlay}
                      playsInline
                      preload="metadata"
                      style={{
                        width: '100%',
                        height: '100%',
                        objectFit: 'cover',
                        pointerEvents: 'none',
                        background: '#020617',
                      }}
                    />
                  ) : o.type === 'audio' && o.mediaUrl ? (
                    <div
                      style={{
                        width: '100%',
                        height: '100%',
                        display: 'flex',
                        alignItems: 'center',
                        gap: 10,
                        padding: '0 12px',
                        background: 'linear-gradient(135deg,#082f49,#0f172a)',
                        color: '#e0f2fe',
                      }}
                    >
                      <div
                        style={{
                          width: 34,
                          height: 34,
                          borderRadius: 999,
                          background: 'rgba(56,189,248,.18)',
                          border: '1px solid rgba(56,189,248,.42)',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontSize: 16,
                          flexShrink: 0,
                        }}
                      >
                        ♪
                      </div>
                      <div style={{ minWidth: 0, flex: 1, textAlign: 'left' }}>
                        <div
                          style={{
                            fontSize: Math.max(10, 12 * scale),
                            fontWeight: 700,
                            whiteSpace: 'nowrap',
                            overflow: 'hidden',
                            textOverflow: 'ellipsis',
                          }}
                        >
                          {o.label || 'Ses'}
                        </div>
                        <div
                          style={{
                            fontSize: Math.max(9, 10 * scale),
                            color: '#7dd3fc',
                            opacity: 0.92,
                          }}
                        >
                          Ses oynaticisi
                        </div>
                      </div>
                    </div>
                  ) : o.type === 'shape' ? (
                    <span
                      style={{
                        pointerEvents: 'none',
                        padding: '0 8px',
                        textAlign: 'center',
                        color: st.color || '#ffffff',
                        opacity: 0.82,
                      }}
                    >
                      {o.label}
                    </span>
                  ) : o.imageData ? (
                    <img
                      src={o.imageData}
                      alt={o.label}
                      style={{
                        width: '100%',
                        height: '100%',
                        objectFit: 'contain',
                        pointerEvents: 'none',
                      }}
                    />
                  ) : (
                    <span
                      style={{
                        pointerEvents: 'none',
                        padding: '0 6px',
                        textAlign: 'center',
                      }}
                    >
                      {o.label}
                    </span>
                  )}
                  {isSel &&
                    !o.locked &&
                    HANDLE_DIRS.map((dir) => {
                      const p = HANDLE_POS[dir];
                      return (
                        <div
                          key={dir}
                          onPointerDown={(e) => startInteract(e, o.id, 'resize', dir)}
                          style={{
                            position: 'absolute',
                            width: 10,
                            height: 10,
                            borderRadius: '50%',
                            background: '#ffffff',
                            border: '2px solid #111111',
                            cursor: HANDLE_CURSOR[dir],
                            zIndex: 10,
                            touchAction: 'none',
                            ...Object.fromEntries(
                              Object.entries(p).filter(([k]) => !['ml', 'mt'].includes(k))
                            ),
                            ...(p.ml ? { marginLeft: p.ml } : {}),
                            ...(p.mt ? { marginTop: p.mt } : {}),
                          }}
                        />
                      );
                    })}
                  {isSel && activity.selectedObjectId === o.id && (
                    <div
                      style={{
                        position: 'absolute',
                        top: -20,
                        left: 0,
                        background: '#ffffff',
                        color: '#111111',
                        fontSize: 9,
                        padding: '2px 6px',
                        borderRadius: 0,
                        border: '1px solid #111111',
                        whiteSpace: 'nowrap',
                        pointerEvents: 'none',
                      }}
                    >
                      {Math.round(o.x)},{Math.round(o.y)} · {Math.round(o.width)}×
                      {Math.round(o.height)}
                    </div>
                  )}
                  {isAnswerPreview && (
                    <div
                      style={{
                        position: 'absolute',
                        top: -20,
                        right: 0,
                        background: isAnswerDragPreview ? '#dbeafe' : '#ffedd5',
                        color: isAnswerDragPreview ? '#1d4ed8' : '#c2410c',
                        fontSize: 9,
                        fontWeight: 800,
                        padding: '2px 6px',
                        borderRadius: 999,
                        border: `1px solid ${isAnswerDragPreview ? '#93c5fd' : '#fdba74'}`,
                        whiteSpace: 'nowrap',
                        pointerEvents: 'none',
                      }}
                    >
                      {isAnswerDragPreview ? 'Surukle secili' : 'Birak secili'}
                    </div>
                  )}
                </div>
              );
            })}
        </div>

        {/* Hidden file inputs */}
        <input
          ref={imgRef}
          type="file"
          accept="image/*"
          onChange={addImage}
          style={{ display: 'none' }}
        />
        <input
          ref={videoRef}
          type="file"
          accept="video/mp4,video/webm,video/ogg"
          onChange={addVideo}
          style={{ display: 'none' }}
        />
        <input
          ref={audioRef}
          type="file"
          accept="audio/*"
          onChange={addAudio}
          style={{ display: 'none' }}
        />
        <input
          ref={fileRef}
          type="file"
          accept=".svg"
          onChange={loadSVG}
          style={{ display: 'none' }}
        />
      </div>
    </div>
  );
});

// ─── Sağ Inspector ─────────────────────────────────────────────────────────────

function RightInspector({
  activity,
  onUpdate,
  selectedIds,
  hideTimeline = false,
  activities = [],
}) {
  if (!activity)
    return (
      <div
        style={{
          width: 240,
          flexShrink: 0,
          borderLeft: '1px solid #252540',
          background: '#111125',
        }}
      />
    );
  const objects = activity.objects || [];
  const layers = getActivityLayers(activity);
  const resolvedLayerNames = useMemo(
    () => buildResolvedLayerNameMap(layers, activity),
    [activity, layers]
  );
  const timeline = activity.timeline || [];
  const triggers = activity.triggers || [];
  const sel = objects.find((o) => o.id === activity.selectedObjectId) || null;
  const multiSel = selectedIds.size > 1;

  const patchAct = (p) => onUpdate({ ...activity, ...p });
  const patchObj = (id, p, options = {}) =>
    onUpdate(updateActivityObject(activity, id, p, options));
  const patchTimeline = (id, p) =>
    patchAct({ timeline: timeline.map((item) => (item.id === id ? { ...item, ...p } : item)) });
  const patchTrigger = (id, p) =>
    patchAct({ triggers: triggers.map((item) => (item.id === id ? { ...item, ...p } : item)) });

  const s10 = {
    fontSize: 10,
    fontWeight: 800,
    color: '#64748b',
    marginBottom: 8,
    letterSpacing: 0.3,
  };
  const card = {
    background: '#ffffff',
    border: '1px solid #d7e0eb',
    borderRadius: 16,
    padding: 12,
    marginBottom: 10,
    boxShadow: '0 12px 24px rgba(15,23,42,.06)',
  };
  const triggerSourceOptions = [
    { value: 'Secili Nesne', label: 'Tiklanan / secili nesne' },
    ...objects.map((obj) => ({ value: obj.id, label: `${obj.label || obj.type} (${obj.type})` })),
  ];
  const triggerTargetOptions = objects.map((obj) => ({
    value: obj.id,
    label: `${obj.label || obj.type} (${obj.type})`,
  }));
  const triggerLayerOptions = layers.map((layer, index) => ({
    value: layer.id,
    label: resolvedLayerNames[layer.id] || `Layer ${index + 1}`,
  }));
  const triggerActivityOptions = [
    { value: '__next__', label: 'Sonraki sahne' },
    ...activities
      .filter((item) => item.id !== activity.id)
      .map((item) => ({ value: item.id, label: item.name })),
  ];

  return (
    <div
      style={{
        width: 280,
        flexShrink: 0,
        borderLeft: '1px solid #d7e0eb',
        background: 'linear-gradient(180deg,#f8fbff,#eef4fb)',
        overflowY: 'auto',
        padding: 12,
      }}
    >
      {/* Seçili nesne özellikleri */}
      {multiSel ? (
        <div style={card}>
          <div style={s10}>SEÇİM</div>
          <div style={{ fontSize: 11, color: '#B0BEC5' }}>{selectedIds.size} nesne seçildi</div>
          <div style={{ fontSize: 10, color: '#555', marginTop: 4 }}>
            Ok tuşları ile taşıyın · Delete ile silin
          </div>
        </div>
      ) : sel ? (
        <div style={card}>
          <div style={{ ...s10, color: '#111111' }}>{sel.type.toUpperCase()}</div>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <Inp
              label="Etiket"
              value={sel.label || ''}
              onChange={(e) => patchObj(sel.id, { label: e.target.value })}
            />
            <div style={{ display: 'flex', gap: 5 }}>
              <Inp
                label="X"
                type="number"
                value={Math.round(sel.x)}
                onChange={(e) => patchObj(sel.id, { x: +e.target.value })}
              />
              <Inp
                label="Y"
                type="number"
                value={Math.round(sel.y)}
                onChange={(e) => patchObj(sel.id, { y: +e.target.value })}
              />
            </div>
            <div style={{ display: 'flex', gap: 5 }}>
              <Inp
                label="G"
                type="number"
                value={Math.round(sel.width)}
                onChange={(e) => patchObj(sel.id, { width: Math.max(20, +e.target.value) })}
              />
              <Inp
                label="Y"
                type="number"
                value={Math.round(sel.height)}
                onChange={(e) => patchObj(sel.id, { height: Math.max(20, +e.target.value) })}
              />
            </div>
            <Inp
              label="Döndür °"
              type="number"
              value={sel.rotation || 0}
              onChange={(e) => patchObj(sel.id, { rotation: +e.target.value })}
            />
            <SelectInp
              label="Layer"
              value={sel.layerId || 'base'}
              onChange={(e) => patchObj(sel.id, { layerId: e.target.value })}
              options={layers.map((layer, index) => ({
                value: layer.id,
                label: resolvedLayerNames[layer.id] || `Layer ${index + 1}`,
              }))}
            />
            {(sel.type === 'draggable' || sel.type === 'dropzone') && (
              <Inp
                label="Grup (eşleştirme)"
                value={sel.group || ''}
                onChange={(e) => patchObj(sel.id, { group: e.target.value })}
                placeholder="A, B, ..."
              />
            )}
            <div>
              <label style={{ fontSize: 10, color: '#78909C', display: 'block', marginBottom: 4 }}>
                Renkler
              </label>
              {(sel.type === 'draggable' || sel.type === 'dropzone') && (
                <div style={{ marginBottom: 6 }}>
                  <label
                    style={{ fontSize: 9, color: '#78909C', display: 'block', marginBottom: 3 }}
                  >
                    Ana renk (kenar+zemin+yazı)
                  </label>
                  <input
                    type="color"
                    value={sel.style?.borderColor || '#2563eb'}
                    onChange={(e) => {
                      const c = e.target.value;
                      const r = parseInt(c.slice(1, 3), 16),
                        g = parseInt(c.slice(3, 5), 16),
                        b = parseInt(c.slice(5, 7), 16);
                      const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
                      const textColor = lum > 0.55 ? '#1a1a2e' : '#ffffff';
                      const bgHex = `${c}22`;
                      patchObj(sel.id, {
                        style: {
                          ...sel.style,
                          borderColor: c,
                          background: bgHex,
                          color: textColor,
                        },
                      });
                    }}
                    style={{
                      width: 40,
                      height: 28,
                      border: '1px solid #e2e8f0',
                      borderRadius: 6,
                      cursor: 'pointer',
                      padding: 2,
                    }}
                  />
                </div>
              )}
              <div style={{ display: 'flex', gap: 6, alignItems: 'center' }}>
                <input
                  type="color"
                  value={sel.style?.color || '#000000'}
                  onChange={(e) =>
                    patchObj(sel.id, { style: { ...sel.style, color: e.target.value } })
                  }
                  style={{
                    width: 28,
                    height: 24,
                    border: 'none',
                    background: 'none',
                    cursor: 'pointer',
                  }}
                />
                <span style={{ fontSize: 9, color: '#78909C' }}>yazı</span>
                <input
                  type="color"
                  value={
                    (sel.style?.background || '#000000')
                      .replace(/[^#0-9a-fA-F]/g, '')
                      .slice(0, 7) || '#000000'
                  }
                  onChange={(e) =>
                    patchObj(sel.id, { style: { ...sel.style, background: e.target.value } })
                  }
                  style={{
                    width: 28,
                    height: 24,
                    border: 'none',
                    background: 'none',
                    cursor: 'pointer',
                  }}
                />
                <span style={{ fontSize: 9, color: '#78909C' }}>zemin</span>
                <input
                  type="color"
                  value={sel.style?.borderColor || '#000000'}
                  onChange={(e) =>
                    patchObj(sel.id, { style: { ...sel.style, borderColor: e.target.value } })
                  }
                  style={{
                    width: 28,
                    height: 24,
                    border: 'none',
                    background: 'none',
                    cursor: 'pointer',
                  }}
                />
                <span style={{ fontSize: 9, color: '#78909C' }}>kenar</span>
              </div>
            </div>
            <div style={{ display: 'flex', gap: 5 }}>
              <Inp
                label="Font"
                type="number"
                value={sel.style?.fontSize || 14}
                onChange={(e) =>
                  patchObj(sel.id, { style: { ...sel.style, fontSize: +e.target.value } })
