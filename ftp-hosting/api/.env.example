# PHP/MySQL API (config.php) ortam degiskenleri ornek dosyasi.
#
# Kullanmak icin: bu dosyayi sunucuda ayni klasore (api/) ".env" olarak
# kopyalayin ve gercek degerleri girin:
#   cp .env.example .env
#
# config.php bu dosyayi (varsa) otomatik okur. ".env" yerelde doldurulduktan
# sonra build.bat/hazirla-ftp.ps1 calistirinca dist/deploy-ftp paketine OTOMATIK
# DAHIL EDILIR (sunucuya yuklerken ayrica elle tasimaya gerek kalmaz).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5

PDF_ANALYSIS_MODE=offline

# /api/index.php icindeki admin islemleri icin token.
ADMIN_TOKEN=

# Sabit iki editor kullanicisi.
USER1_NAME=Kullanici 1
USER1_PASSWORD=
USER2_NAME=Kullanici 2
USER2_PASSWORD=

# Virgulle ayrilmis izinli CORS origin listesi. Canli URL:
ALLOWED_ORIGINS=https://editori.hepsibirdijital.com
